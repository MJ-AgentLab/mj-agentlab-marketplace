**/config/secrets-*.conf

# Plugin .env files (generated by setup scripts)
plugins/mj-ops/.env
plugins/mj-git/.env

# learn-kit artifacts — `/learn-kit:scaffold-learning` scaffolds learning/<topic>/
# at the project root; these are user-generated learning materials (tier .md /
# HTML / NLM artifact metadata), not marketplace repo content. Anchored to root
# only; any nested `learning/` (e.g., inside a plugin) is intentionally NOT
# ignored.
/learning/
