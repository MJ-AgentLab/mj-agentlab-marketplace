    {
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      },
      "description": "Add a source to a notebook. Unified tool for all source types.\n\nSupports: url, text, drive, file",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "doc_type": {
            "default": "doc",
            "description": "Drive doc type: doc|slides|sheets|pdf (for source_type=drive)",
            "type": "string"
          },
          "document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Google Drive document ID (for source_type=drive)"
          },
          "file_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Local file path on the machine running the MCP server\n(for source_type=file). A path on a different client/agent host\nis not accessible to the server."
          },
          "notebook_id": {
            "description": "Notebook UUID",
            "type": "string"
          },
          "source_type": {
            "description": "Type of source to add:\n- url: Web page or YouTube URL\n- text: Pasted text content\n- drive: Google Drive document\n- file: Local file upload. Supported extensions:\n    PDF, TXT, MD, DOCX, CSV, EPUB, MP3, M4A, WAV, AAC, OGG,\n    OPUS, MP4, JPG, JPEG, PNG, GIF, WEBP. Image-bearing\n    sources (PDF / JPG / PNG / etc.) feed Studio video\n    generation's visual-crop pipeline \u2014 charts, photos, and\n    diagrams may be extracted as on-screen aids in Video\n    Overviews.",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Text content to add (for source_type=text)"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Display title (for text sources)"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "URL to add (for source_type=url)"
          },
          "urls": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
