          "wait": {
            "default": false,
            "description": "If True, wait for source processing to complete before returning",
            "type": "boolean"
          },
          "wait_timeout": {
            "default": 120.0,
            "description": "Max seconds to wait if wait=True (default 120)",
            "type": "number"
          }
        },
        "required": [
          "notebook_id",
          "source_type"
        ],
        "type": "object"
      },
      "name": "source_add",
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      }
