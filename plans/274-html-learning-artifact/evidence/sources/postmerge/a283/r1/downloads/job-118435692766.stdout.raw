const carrierMatches = (run, live) => coarseRun(run) && run.event === "pull_request" && run.id !== context.runId && run.head_sha === context.sha && association(run, live) && run.display_title === marker("pull_request", live.number, context.sha, live.base.sha, live.base.ref) && eligible(run);
const proveRef = async (ref, expected) => {
  const value = (await read(input => github.rest.git.getRef(input), { ref: "heads/" + ref })).data;
  check(value?.ref === "refs/heads/" + ref && value.object?.type === "commit" && value.object.sha === expected, "git_ref_changed");
};
const sourceAt = async (ref, role) => {
  const data = (await read(input => github.rest.repos.getContent(input), { path: workflowPath, ref })).data;
  check(data?.type === "file" && data.name === "ci.yml" && data.path === workflowPath && data.encoding === "base64" && sha(data.sha) && Number.isSafeInteger(data.size) && data.size > 0 && data.size <= 1000000 && typeof data.content === "string", "unproved_source_metadata");
  const encoded = data.content.replace(/[\r\n]/g, "");
  check(encoded.length % 4 === 0 && /^[A-Za-z0-9+/]*={0,2}$/.test(encoded), "invalid_source_base64");
  const bytes = Buffer.from(encoded, "base64");
  check(bytes.length === data.size && bytes.toString("base64") === encoded, "inconsistent_source_bytes");
  const blob = require("node:crypto").createHash("sha1").update(`blob ${bytes.length}\0`).update(bytes).digest("hex");
  check(blob === data.sha, "inconsistent_source_blob");
  const expression = value => "$" + "{{ " + value + " }}";
  const fixed = "ci-v1|event=" + expression("github.event_name") + "|pr=" + expression("github.event.pull_request.number || 0") + "|repo=" + expression("github.repository_id") + "|headrepo=" + expression("github.event.pull_request.head.repo.id || github.repository_id") + "|head=" + expression("github.event.pull_request.head.sha || github.sha") + "|baserepo=" + expression("github.event.pull_request.base.repo.id || github.repository_id") + "|base=" + expression("github.event.pull_request.base.sha || github.sha") + "|target=" + expression("github.event.pull_request.base.ref || '-'");
  const lines = new TextDecoder("utf-8", { fatal: true }).decode(bytes).replace(/\r\n/g, "\n").split("\n");
  const index = lines.indexOf("run-name: >-");
  check(index >= 0 && lines[index + 1] === "  " + fixed && lines.filter(line => /^run-name\s*:/.test(line)).length === 1, "unproved_fixed_run_name");
  report.sourceProofs.push({ role, ref, blobSha: blob, bytes: bytes.length });
