const id = value => Number.isSafeInteger(value) && value > 0;
const sha = value => typeof value === "string" && /^[a-f0-9]{40}$/.test(value);
const owner = "MJ-AgentLab", repo = "mj-agentlab-marketplace", repositoryId = 1183002256;
const workflowId = 247197116, workflowPath = ".github/workflows/ci.yml";
const matrixNames = ["Baseline compat (ubuntu-latest)", "Baseline compat (windows-latest)"];
