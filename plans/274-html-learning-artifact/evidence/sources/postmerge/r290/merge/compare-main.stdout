ml-learning-artifact%2Fevidence%2Fsources%2Fpostmerge%2Fd289%2Findependent%2Fprebump-review-v1-freeze.json","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Fpostmerge%2Fd289%2Findependent%2Fprebump-review-v1-freeze.json","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Fpostmerge%2Fd289%2Findependent%2Fprebump-review-v1-freeze.json?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,16 @@\n+{\r\n+  \"frozenAt\": \"2026-10-20T13:18:21.312942+00:00\",\r\n+  \"root\": \"C:\\\\Users\\\\Admin\\\\.codex\\\\task-evidence\\\\html-learning-274-post289-20261020\\\\actual-develop-independent\\\\prebump-review-v1\",\r\n+  \"files\": [\r\n+    {\r\n+      \"path\": \"execute-prebump-reviewed.py\",\r\n+      \"bytes\": 3407,\r\n+      \"sha256\": \"7cee36c3684fb9d9d145267968604ff36bfbbc0d11a1501e051488960396171a\"\r\n+    },\r\n+    {\r\n+      \"path\": \"review.json\",\r\n+      \"bytes\": 3050,\r\n+      \"sha256\": \"af565d9b542425e36602192e2d819a4d0e946cbbe443b62c285a99cd6c715323\"\r\n+    }\r\n+  ]\r\n+}\r"},{"sha":"872e3f09f1e22ee001739c24dda95c8aeb9a80bc","filename":"plans/274-html-learning-artifact/evidence/sources/postmerge/d289/independent/prepare-and-review.py","status":"added","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Fpostmerge%2Fd289%2Findependent%2Fprepare-and-review.py","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Fpostmerge%2Fd289%2Findependent%2Fprepare-and-review.py","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Fpostmerge%2Fd289%2Findependent%2Fprepare-and-review.py?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,20 @@\n+import ast,datetime,hashlib,json,pathlib\n+\n+OUT=pathlib.Path(__file__).resolve().parent\n+ROOT=OUT.parent\n+source=ROOT/'execute-prebump.py'\n+data=source.read_bytes();text=data.decode('utf-8');ast.parse(text,filename=str(source))\n+review=OUT/'prebump-review-v1';review.mkdir(exist_ok=False)\n+(review/'execute-prebump-reviewed.py').write_bytes(data)\n+findings=[\n+ {'id':'R1','priority':'BEFORE_GO','title':'Bind finished prerequisite receipts to the actual develop identity and independent result','evidence':'Current code accepts aggregate smoke/local booleans but does not assert their recorded source SHA/tree or a completed independent audit.','recommendation':'Require smoke config/result canonicalSHA and tree f3e8/6daad, local launch and before/after source identity, terminal timestamps, and the new independent audit PASS before version writes.'},\n+ {'id':'R2','priority':'BEFORE_GO','title':'Check tracked key sets, HEAD and complete final status paths after DryRun and Apply','evidence':'Current changed list iterates only previous tracked names and has no final git status check; a leftover untracked .bump-backup from tool cleanup could escape the assertion of exactly two modified files.','recommendation':'Assert identical tracked-key sets and unchanged HEAD, DryRun no status changes, Apply exact two tracked modifications README.md and VERSION with no untracked/unmerged paths; verify VERSION bytes and exact README badge replacement.'},\n+ {'id':'R3','priority':'REPORTING','title':'Distinguish bounded command scope from externally observed absence of publication changes','evidence':'summary noReleaseTagOrSiteMutation=True is a hard-coded statement; this script does not read external publication or Site state.','recommendation':'Label it as no publish/tag/Sites mutation commands invoked, or separately retain fresh readbacks. Do not present a static code-scope assertion as live publication evidence.'}\n+]\n+summary={'reviewedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),'status':'READ_ONLY_REVIEW_CHANGES_RECOMMENDED_BEFORE_GO','reviewedPath':str(source),'reviewedBytes':len(data),'reviewedSha256':hashlib.sha256(data).hexdigest(),'authorization':'User authorized actualdevelop verification then marketplace-only8.3.4 preparation; no new product decision or publication authorization inferred.','positive':['Explicit --go required.','Frozen host HEAD f3e8 and clean tree precondition.','marketplace scope From8.3.3 To8.3.4; DryRun before Apply.','Actual bumped script marketplace targets are VERSION and README.md only; no plugin manifest target.','Tracked before/after hashes and plugin versions checked; exact README badge bytes checked.','No commit, push, merge, tag, release or Sites command in the reviewed execution path.'],'findings':findings,'actualPrerequisites':'RUNNING_OR_NOT_YET_INDEPENDENTLY_ATTESTED; no PASS claimed','newOwnerDecisionRequired':False,'nextRecommendation':'Strengthen these routine guards, finish the two current unique batches, and run independent terminal evidence audit before explicit version GO.'}\n+(review/'review.json').write_text(json.dumps(summary,ensure_ascii=False,indent=2)+'\\n',encoding='utf-8')\n+files=[]\n+for file in sorted(review.iterdir()):\n+    b=file.read_bytes();files.append({'path':file.name,'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()})\n+(OUT/'prebump-review-v1-freeze.json').write_text(json.dumps({'frozenAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),'root':str(review),'files':files},ensure_ascii=False,indent=2)+'\\n',encoding='utf-8')\n+print(json.dumps({'status':summary['status'],'findings':len(findings),'sourceSha256':summary['reviewedSha256'],'noActualPrebumpExecutedByReviewer':True}))"},{"sha":"98187540469bc1364d9a29847d8adee803b6186b","filename":"plans/274-html-learning-artifact/evidence/sources/postmerge/d289/independent/review-final-scripts-v3.py","status":"added","additions":37,"deletions":0,"changes":37,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Fpostmerge%2Fd289%2Findependent%2Freview-final-scripts-v3.py","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Fpostmerge%2Fd289%2Findependent%2Freview-final-scripts-v3.py","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Fpostmerge%2Fd289%2Findependent%2Freview-final-scripts-v3.py?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,37 @@\n+import ast,datetime,difflib,hashlib,json,pathlib\n+OUT=pathlib.Path(__file__).resolve().parent;ROOT=OUT.parent\n+OLD=OUT/'guarded-scripts-review-v2';NEW=OUT/'guarded-scripts-review-v3'\n+NEW.mkdir(exist_ok=False)\n+checks=[]\n+def check(name,value,observed=None):checks.append({'name':name,'passed':bool(value),'observed':observed})\n+sources={}\n+for name in ['execute-prebump.py','prepare-documents.py']:\n+    data=(ROOT/name).read_bytes();old=(OLD/name).read_bytes();text=data.decode();oldtext=old.decode();tree=ast.parse(text,filename=name)\n+    (NEW/name).write_bytes(data)\n+    (NEW/(name+'.diff')).write_text(''.join(difflib.unified_diff(oldtext.splitlines(True),text.splitlines(True),fromfile='v2/'+name,tofile='v3/'+name)),encoding='utf-8')\n+    sources[name]={'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest(),'sameAsV2':data==old}\n+    if name=='prepare-documents.py':d=text;docTree=tree;oldDoc=ast.parse(oldtext)\n+check('guarded prebump exact reviewedv2bytes unchanged',sources['execute-prebump.py']['sameAsV2'],sources['execute-prebump.py'])\n+check('documents all helper