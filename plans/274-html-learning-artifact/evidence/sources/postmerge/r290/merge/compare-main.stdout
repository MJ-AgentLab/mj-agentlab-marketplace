74-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/site/THIRD_PARTY_NOTICES.md","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2FTHIRD_PARTY_NOTICES.md","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2FTHIRD_PARTY_NOTICES.md","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2FTHIRD_PARTY_NOTICES.md?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,22 @@\n+# Generated artifact asset notices\n+\n+The package LICENSE covers MJ-AgentLab's original template and runtime contributions,\n+including the scaffold portions of index.html, theme.css and learning.js. These\n+notices do not relicense supplied materials, learning content or source documents;\n+those retain their respective rights and permissions.\n+\n+The complete package notices below retain their original bytes. Paths such as\n+skills/site/references/resource-provenance.json refer to the original installed plugin,\n+not to files promised inside this generated artifact. The accompanying Apache text\n+preserves the package's upstream-reference notice and does not classify independently\n+implemented ideas or supplied content as Apache-licensed derivative works.\n+\n+---\n+\n+# Source and license notices\n+\n+The site extension contains original summaries and independently implemented tools. The method and file identities are recorded in `skills/site/references/resource-provenance.json`. Research checkouts have no identified redistribution license; no research source code or prose is copied verbatim into this distribution.\n+\n+General style-injection, copy-feedback and browser-geometry ideas were reviewed against evalstate/birch-html at e2ea9a3aca7e97f2b2a431cfa392aa4e99d8fa90. The visual direction also references ThariqS/html-effectiveness at 1787245d94aa680edf18b52027e3f859032776ba. Both fixed repositories identify Apache License 2.0 and Copyright 2026 Anthropic PBC. Their license text is retained in `licenses/Apache-2.0.txt`; upstream rights are not relabeled MIT. No Birch/HTML Plan runtime, remote font, script, stylesheet or automatic downloader is included.\n+\n+The package MIT license applies to its original contributions. Source and verification hashes establish byte identity, not authorship, semantic correctness or learning effects. AICS summaries remain Lab Proposal / Informative and do not announce a formal standard or adopted research rule."},{"sha":"db954bab41b1e3dc135733b5e2a210ab25d2f2eb","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/site/artifact-manifest.json","status":"added","additions":53,"deletions":0,"changes":53,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Fartifact-manifest.json","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Fartifact-manifest.json","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Fartifact-manifest.json?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,53 @@\n+{\n+  \"schemaVersion\": 1,\n+  \"artifactPath\": \"artifact.json\",\n+  \"sourceSha256\": \"c80fdc5fbd113257d43779f67a783017b65a69f8318bb1405800f3c03352e44f\",\n+  \"version\": \"synthetic-1.0\",\n+  \"files\": [\n+    {\n+      \"path\": \"artifact.json\",\n+      \"sha256\": \"c80fdc5fbd113257d43779f67a783017b65a69f8318bb1405800f3c03352e44f\",\n+      \"bytes\": 4077\n+    },\n+    {\n+      \"path\": \"content.md\",\n+      \"sha256\": \"060045ce718168c7f3c2aecd2742518490d5693e3dbdeb28b4ac94ce2885cd50\",\n+      \"bytes\": 2751\n+    },\n+    {\n+      \"path\": \"index.html\",\n+      \"sha256\": \"12101458fb0d6d58bf902b8497feb73b742d3cec4e3409255fd07c7984de3785\",\n+      \"bytes\": 13298\n+    },\n+    {\n+      \"path\": \"learning.js\",\n+      \"sha256\": \"1fcc8c6064dd99f00b91103cf76e33d7a4e6dcf50793b4542bd8462f6c91f568\",\n+      \"bytes\": 7378\n+    },\n+    {\n+      \"path\": \"LICENSE\",\n+      \"sha256\": \"cfd483b2cc03452033bbc34d6ceabcc46d9917539070f6721d671705926a2a8d\",\n+      \"bytes\": 1068\n+    },\n+    {\n+      \"path\": \"licenses/Apache-2.0.txt\",\n+      \"sha256\": \"30deeaa611125310673e7c14b4892fb102fb56697ecfab3b49b77ca0190de7e1\",\n+      \"bytes\": 11343\n+    },\n+    {\n+      \"path\": \"sources/renewal-rules.md\",\n+      \"sha256\": \"2a95c4d9b95f3b184fea30aa3fba9daaf34d11624bd888ed4793a0ea7f96af47\",\n+      \"bytes\": 1011\n+    },\n+    {\n+      \"path\": \"theme.css\",\n+      \"sha256\": \"32c88191ef5e0c5e97668f22c6571d3f27d10ae76458ebdc31db6240b309f835\",\n+      \"bytes\": 6313\n+    },\n+    {\n+      \"path\": \"THIRD_PARTY_NOTICES.md\",\n+      \"sha256\": \"85d44b9273c04eda33d5f739f01cf4994fb8aeedb186955f5d7cd3336dd5e65e\",\n+      \"bytes\": 1944\n+    }\n+  ]\n+}"},{"sha":"d6d0f889354411fdc2342e376c4a5bd4adf88e26","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/site/artifact.json","status":"added","additions":105,"deletions":0,"changes":105,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Fartifact.json","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Fartifact.json","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Fartifact.json?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,105 @@\n+{\n+  \"schemaVersion\": 1,\n+  \"title\": \"Library Renewal · 续借判断学习制品\",\n+  \"version\": \"synthetic-1.0\",\n+  \"audience\": \"能够读懂基本日期，但尚未区分规则许可、申请提交与完成确认的学习者。\",\n+  \"task\": \"根据本页自编规则，解释续借是否允许、成功或失败后的日期，以及确认完成所需依据。\",\n+  \"goals\": [\n+    \"用两个必要条件的组合解释规则许可，不把且改为或。\",\n+    \"从原到期日计算成功后的七个日历日，失败时保留原日期。\",\n+    \"区分提交、成功确认与未知结果，并指出确认所需的两项依据。\"\n+  ],\n+  \"markdown\": \"content.md\",\n+  \"sources\": [\n+    {\n+      \"id\": \"renewal-rules\",\n+      \"title\": \"Synthetic Renewal Rules · 自编续借规则\",\n+      \"path\": \"sources/renewal-rules.md\",\n+      \"locator\": \"LIB1–LIB4；本插件的合成验收材料，不是任何真实图书馆政策。\"\n+    }\n+  ],\n+  \"terms\": [\n+    {\n+      \"english\": \"Rule Permission\",\n+      \"chinese\": \"规则许可\",\n+      \"forbidden\": [\n+        \"规则批准\"\n+      ]\n+    },\n+    {\n+      \"english\": \"Submission\",\n+      \"chinese\": \"申请提交\"\n+    },\n+    {\n+      \"english\": \"Completion Confirmation\",\n+      \"chinese\": \"完成确认\"\n+    },\n+    {\n+      \"english\": \"Calendar Day\",\n+      \"chinese\": \"日历日\",\n+      \"forbidden\": [\n+        \"工作天\"\n+      ]\n+    }\n+  ],\n+  \"activities\": [\n+    {\n+      \"id\": \"permission-check\",\n+      \"type\": \"choice\",\n+      \"title\": \"Rule Permission · 核对规则许可\",\n+      \"prompt\": \"一本书尚未逾期，但已有其他读者预约。按 LIB2，本次是否允许续借？\",\n+      \"options\": [\n+        {\n+          \"label\": \"允许，因为尚未逾期。\",\n+          \"feedback\": \"尚未逾期只满足一项条件；LIB2 还要求没有其他读者预约。\"\n+        },\n+        {\n+          \"label\": \"不允许，因为预约条件不满足。\",\n+          \"feedback\": \"两个条件必须同时成立；已有预约使本次不满足完整规则。\"\n+        }\n+      ],\n+      \"correctIndex\": 1,\n+      \"reference\": \"本次不允许。LIB2 要求尚未逾期且没有其他读者预约，两项条件同时成立才规则允许；规则允许仍不等于已成功。\",\n+      \"sourceId\": \"renewal-rules\"\n+    },\n+    {\n+      \"id\": \"date-check\",\n+      \"type\": \"choice\",\n+      \"title\": \"Calendar Day · 核对跨月日期\",\n+      \"prompt\": \"原到期日为 2026-10-29。按 LIB3，续借成功与失败后分别何时归还？\",\n+      \"options\": [\n+        {\n+          \"label\": \"成功后为 2026-11-05；失败时仍为 2026-10-29。\",\n+          \"feedback\": \"成功从原到期日增加七个日历日，跨月仍适用；失败不改原日期。\"\n+        },\n+        {\n+          \"label\": \"成功和失败后都为 2026-11-05。\",\n+          \"feedback\": \"失败时没有日期延后；不能把成功后的效果套到失败状态。\"\n+        }\n+      ],\n+      \"correctIndex\": 0,\n+      \"reference\": \"成功：2026-11-05；失败：2026-10-29。日期基准是原到期日，不是申请日；增加的是七个日历日。\",\n+      \"sourceId\": \"renewal-rules\"\n+    },\n+    {\n+      \"id\": \"completion-check\",\n+      \"type\": \"choice\",\n+      \"title\": \"Completion Confirmation · 核对完成依据\",\n+      \"prompt\": \"已经点击申请，但尚未看到成功文字与更新后的归还日期。按 LIB4，此时能确认什么？\",\n+      \"options\": [\n+        {\n+          \"label\": \"已完成，因为已点击申请。\",\n+          \"feedback\": \"点击只表示申请提交，不能替代成功文字与日期更新两项确认依据。\"\n+        },\n+        {\n+          \"label\": \"已提交，结果尚不能确认；也不能据此断定失败。\",\n+          \"feedback\": \"LIB4 把提交与确认成功分开；缺少成功确认不等于已知失败。\"\n+        }\n+      ],\n+      \"correctIndex\": 1,\n+      \"reference\": \"只能确认申请提交。完成确认需同时有续借成功文字和更新后的归还日期；结果未确认时保留未知，不补造失败或后台步骤。\",\n+      \"sourceId\": \"renewal-rules\"\n+    }\n+  ],\n+  \"theme\": \"neutral\"\n+}"},{"sha":"4abaf6a89085af9ff0dc3765cdb079255595985e","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/site/content.md","status":"added","additions":45,"deletions":0,"changes":45,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Fcontent.md","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Fcontent.md","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Fcontent.md?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,45 @@\n+# Overview · 先区分三个判断\n+\n+本材料使用项目自编的图书续借规则，帮助核对条件、日期与完成依据。它不是任何真实图书馆政策，不连接图书馆或提交真实申请。\n+\n+**Rule Permission**（规则许可）说明规则是否允许本次续借。**Submission**（申请提交）说明已提出申请。**Completion Confirmation**（完成确认）说明哪些可见依据足以确认成功；三个判断不能互相代替。\n+\n+## Necessary Foundations · 条件与日历日\n+\n+本练习只处理一本书的一次续借。两项条件用“且”连接，表示必须同时成立，不能满足一项就视为全部满足。**Calendar Day**（日历日）按连续日期计算，周末和跨月也计入。\n+\n+完整原件在 [Synthetic Renewal Rules](sources/renewal-rules.md)，以下解释对应 LIB2–LIB4。\n+\n+## Rule Permission · 同时核对两项条件\n+\n+尚未逾期且没有其他读者预约时，本练习规则允许续借。任一条件不满足，就不能按这条规则续借。规则允许不表示申请已经成功。\n+\n+| 尚未逾期 | 没有其他读者预约 | LIB2 的规则许可 |\n+| --- | --- | --- |\n+| 是 | 是 | 允许，但成功仍须按 LIB4 确认 |\n+| 是 | 否 | 不允许 |\n+| 否 | 是 | 不允许 |\n+| 否 | 否 | 不允许 |\n+\n+比较时同时查看四种组合。表格呈现条件组合，不表示先后办理步骤。\n+\n+## Date Outcome · 从原到期日计算\n+\n+按 LIB3，续借成功后，归还日期在原到期日基础上延后七个日历日；续借失败时，原到期日不变。\n+\n+- 原到期日 2026-10-20：成功后为 2026-10-27；失败时仍为 2026-10-20。\n+- 原到期日 2026-10-29：成功后为 2026-11-05；失败时仍为 2026-10-29。\n+\n+规则没有用申请日计算，也没有排除周末。日期结果需要已知成功或失败；结果未知时，不能自行选择其中一种结果来改写到期日。\n+\n+## Completion Confirmation · 保留未知结果\n+\n+按 LIB4，点击“申请续借”只表示申请提交。页面显示“续借成功”并更新归还日期后，才能确认续借完成，两项依据必须同时出现。\n+\n+没有成功确认不等于已确认失败。规则未提供完整后台状态机，也没有说明等待时长；不要自行补造审批步骤或超时失败。\n+\n+## Integrated Practice · 说明你的判断\n+\n+阅读下面的局部练习时，可以回查正文与来源。先写清当前给定条件，再解释规则、日期和完成状态分别能确认什么。修改答案后重新核对，不能沿用旧反馈。\n+\n+核对与反馈只对应这些教学题。页面可操作或一次答对，不能证明长期掌握、迁移能力或设计改善了理解；Understanding Effects 保持 NOT_MEASURED。"},{"sha":"adc8b0ea0a147de6422a660c4c91089981698f73","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/site/index.html","status":"added","additions":36,"deletions":0,"changes":36,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Findex.html","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Findex.html","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Findex.html?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,36 @@\n+<!doctype html>\n+<html lang=\"zh-CN\">\n+<head>\n+  <meta charset=\"utf-8\">\n+  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n+  <meta name=\"description\" content=\"围绕明确读者、任务与材料制作的学习制品。\">\n+  <title>Library Renewal · 续借判断学习制品</title>\n+  <link rel=\"stylesheet\" href=\"theme.css\">\n+  <script src=\"learning.js\" defer></script>\n+</head>\n+<body>\n+  <a class=\"skip-link\" href=\"#main\">跳到正文</a>\n+  <div class=\"paper\"><header class=\"masthead\"><p>Learning Artifact · 学习制品</p><p>Version · synthetic-1.0</p></header><main id=\"main\"><section class=\"hero\"><p class=\"eyebrow\">Read · Explore · Check</p><h1>Library Renewal · 续借判断学习制品</h1><dl><dt>Audience · 目标读者</dt><dd>能够读懂基本日期，但尚未区分规则许可、申请提交与完成确认的学习者。</dd><dt>Task · 使用任务</dt><dd>根据本页自编规则，解释续借是否允许、成功或失败后的日期，以及确认完成所需依据。</dd></dl><h2>Understanding Goals · 理解目标</h2><ul><li>用两个必要条件的组合解释规则许可，不把且改为或。</li><li>从原到期日计算成功后的七个日历日，失败时保留原日期。</li><li>区分提交、成功确认与未知结果，并指出确认所需的两项依据。</li></ul><p class=\"scope\">Understanding Effects · NOT_MEASURED。页面、工程检查和本题核对各按实际范围报告，理解效果尚未测量。</p><a href=\"content.md\" download>下载材料 Markdown</a></section><section class=\"reading\" aria-label=\"学习材料\"><h2 id=\"section-1\">Overview · 先区分三个判断</h2>\n+<p>本材料使用项目自编的图书续借规则，帮助核对条件、日期与完成依据。它不是任何真实图书馆政策，不连接图书馆或提交真实申请。</p>\n+<p><strong>Rule Permission</strong>（规则许可）说明规则是否允许本次续借。<strong>Submission</strong>（申请提交）说明已提出申请。<strong>Completion Confirmation</strong>（完成确认）说明哪些可见依据足以确认成功；三个判断不能互相代替。</p>\n+<h3 id=\"section-2\">Necessary Foundations · 条件与日历日</h3>\n+<p>本练习只处理一本书的一次续借。两项条件用“且”连接，表示必须同时成立，不能满足一项就视为全部满足。<strong>Calendar Day</strong>（日历日）按连续日期计算，周末和跨月也计入。</p>\n+<p>完整原件在 <a href=\"sources/renewal-rules.md\">Synthetic Renewal Rules</a>，以下解释对应 LIB2–LIB4。</p>\n+<h3 id=\"section-3\">Rule Permission · 同时核对两项条件</h3>\n+<p>尚未逾期且没有其他读者预约时，本练习规则允许续借。任一条件不满足，就不能按这条规则续借。规则允许不表示申请已经成功。</p>\n+<div class=\"table-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"可横向查看的材料表格\"><table><thead><tr><th scope=\"col\">尚未逾期</th><th scope=\"col\">没有其他读者预约</th><th scope=\"col\">LIB2 的规则许可</th></tr></thead><tbody><tr><td>是</td><td>是</td><td>允许，但成功仍须按 LIB4 确认</td></tr><tr><td>是</td><td>否</td><td>不允许</td></tr><tr><td>否</td><td>是</td><td>不允许</td></tr><tr><td>否</td><td>否</td><td>不允许</td></tr></tbody></table></div>\n+<p>比较时同时查看四种组合。表格呈现条件组合，不表示先后办理步骤。</p>\n+<h3 id=\"section-4\">Date Outcome · 从原到期日计算</h3>\n+<p>按 LIB3，续借成功后，归还日期在原到期日基础上延后七个日历日；续借失败时，原到期日不变。</p>\n+<ul><li>原到期日 2026-10-20：成功后为 2026-10-27；失败时仍为 2026-10-20。</li><li>原到期日 2026-10-29：成功后为 2026-11-05；失败时仍为 2026-10-29。</li></ul>\n+<p>规则没有用申请日计算，也没有排除周末。日期结果需要已知成功或失败；结果未知时，不能自行选择其中一种结果来改写到期日。</p>\n+<h3 id=\"section-5\">Completion Confirmation · 保留未知结果</h3>\n+<p>按 LIB4，点击“申请续借”只表示申请提交。页面显示“续借成功”并更新归还日期后，才能确认续借完成，两项依据必须同时出现。</p>\n+<p>没有成功确认不等于已确认失败。规则未提供完整后台状态机，也没有说明等待时长；不要自行补造审批步骤或超时失败。</p>\n+<h3 id=\"section-6\">Integrated Practice · 说明你的判断</h3>\n+<p>阅读下面的局部练习时，可以回查正文与来源。先写清当前给定条件，再解释规则、日期和完成状态分别能确认什么。修改答案后重新核对，不能沿用旧反馈。</p>\n+<p>核对与反馈只对应这些教学题。页面可操作或一次答对，不能证明长期掌握、迁移能力或设计改善了理解；Understanding Effects 保持 NOT_MEASURED。</p>\n+</section><section aria-labelledby=\"terms-heading\"><h2 id=\"terms-heading\">Terminology · 术语</h2><dl class=\"terms\"><div><dt>Rule Permission</dt><dd>规则许可</dd></div><div><dt>Submission</dt><dd>申请提交</dd></div><div><dt>Completion Confirmation</dt><dd>完成确认</dd></div><div><dt>Calendar Day</dt><dd>日历日</dd></div></dl></section><section aria-labelledby=\"activities-heading\"><h2 id=\"activities-heading\">Local Practice · 局部练习</h2><p>先作判断，再核对参考与依据。参考仅适用于本题材料；作答不代表长期掌握或理解改善。</p><div class=\"practice-controls enhancement\"><p id=\"practice-status\" role=\"status\">尚未核对题目。</p><button type=\"button\" data-reset>重新开始</button></div><article class=\"activity\" id=\"activity-permission-check\"><h3>Rule Permission · 核对规则许可</h3><p class=\"scenario\">一本书尚未逾期，但已有其他读者预约。按 LIB2，本次是否允许续借？</p><form data-activity=\"permission-check\"><fieldset><legend>选择一个判断，再核对理由</legend><label class=\"option\"><input type=\"radio\" name=\"permission-check\" value=\"0\"><span>允许，因为尚未逾期。</span></label><label class=\"option\"><input type=\"radio\" name=\"permission-check\" value=\"1\"><span>不允许，因为预约条件不满足。</span></label></fieldset><button class=\"enhancement\" type=\"submit\">核对判断</button><div data-feedback id=\"feedback-permission-check\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></div></form><details><summary>Reference Judgment · 查看参考判断</summary><p>不允许，因为预约条件不满足。</p><p>本次不允许。LIB2 要求尚未逾期且没有其他读者预约，两项条件同时成立才规则允许；规则允许仍不等于已成功。</p><a href=\"#source-renewal-rules\">查看依据</a></details></article><article class=\"activity\" id=\"activity-date-check\"><h3>Calendar Day · 核对跨月日期</h3><p class=\"scenario\">原到期日为 2026-10-29。按 LIB3，续借成功与失败后分别何时归还？</p><form data-activity=\"date-check\"><fieldset><legend>选择一个判断，再核对理由</legend><label class=\"option\"><input type=\"radio\" name=\"date-check\" value=\"0\"><span>成功后为 2026-11-05；失败时仍为 2026-10-29。</span></label><label class=\"option\"><input type=\"radio\" name=\"date-check\" value=\"1\"><span>成功和失败后都为 2026-11-05。</span></label></fieldset><button class=\"enhancement\" type=\"submit\">核对判断</button><div data-feedback id=\"feedback-date-check\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></div></form><details><summary>Reference Judgment · 查看参考判断</summary><p>成功后为 2026-11-05；失败时仍为 2026-10-29。</p><p>成功：2026-11-05；失败：2026-10-29。日期基准是原到期日，不是申请日；增加的是七个日历日。</p><a href=\"#source-renewal-rules\">查看依据</a></details></article><article class=\"activity\" id=\"activity-completion-check\"><h3>Completion Confirmation · 核对完成依据</h3><p class=\"scenario\">已经点击申请，但尚未看到成功文字与更新后的归还日期。按 LIB4，此时能确认什么？</p><form data-activity=\"completion-check\"><fieldset><legend>选择一个判断，再核对理由</legend><label class=\"option\"><input type=\"radio\" name=\"completion-check\" value=\"0\"><span>已完成，因为已点击申请。</span></label><label class=\"option\"><input type=\"radio\" name=\"completion-check\" value=\"1\"><span>已提交，结果尚不能确认；也不能据此断定失败。</span></label></fieldset><button class=\"enhancement\" type=\"submit\">核对判断</button><div data-feedback id=\"feedback-completion-check\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></div></form><details><summary>Reference Judgment · 查看参考判断</summary><p>已提交，结果尚不能确认；也不能据此断定失败。</p><p>只能确认申请提交。完成确认需同时有续借成功文字和更新后的归还日期；结果未确认时保留未知，不补造失败或后台步骤。</p><a href=\"#source-renewal-rules\">查看依据</a></details></article></section><section aria-labelledby=\"reflection-heading\"><h2 id=\"reflection-heading\">Reflection · 应用与意见</h2><label for=\"reflection\">写下你的解释、应用判断或待核对问题</label><textarea id=\"reflection\" rows=\"5\"></textarea><p>记录只在当前页面会话中；刷新或关闭后不保留。可复制文字自行保存。</p><div class=\"enhancement export-controls\"><button type=\"button\" data-export>生成记录</button><button type=\"button\" data-copy disabled>复制记录</button><a data-download hidden download=\"learning-record.md\">下载记录</a></div><div class=\"enhancement export-box\"><label for=\"export-text\">本次记录，可手动复制</label><textarea id=\"export-text\" rows=\"8\" readonly aria-describedby=\"export-status\"></textarea><p id=\"export-status\" role=\"status\" aria-live=\"polite\"></p><button type=\"button\" data-copy-return hidden>返回复制按钮</button></div></section><section aria-labelledby=\"sources-heading\"><h2 id=\"sources-heading\">Sources and Scope · 来源与范围</h2><ol class=\"sources\"><li id=\"source-renewal-rules\"><strong>Synthetic Renewal Rules · 自编续借规则</strong><p>LIB1–LIB4；本插件的合成验收材料，不是任何真实图书馆政策。</p><a href=\"sources/renewal-rules.md\">读取本地材料</a></li></ol></section></main><footer>材料、练习记录、实际检查与学习效果分别判断。</footer></div>\n+  <script type=\"application/json\" id=\"artifact-state\">{\"title\":\"Library Renewal · 续借判断学习制品\",\"version\":\"synthetic-1.0\",\"audience\":\"能够读懂基本日期，但尚未区分规则许可、申请提交与完成确认的学习者。\",\"task\":\"根据本页自编规则，解释续借是否允许、成功或失败后的日期，以及确认完成所需依据。\",\"activities\":[{\"id\":\"permission-check\",\"type\":\"choice\",\"title\":\"Rule Permission · 核对规则许可\",\"prompt\":\"一本书尚未逾期，但已有其他读者预约。按 LIB2，本次是否允许续借？\",\"options\":[{\"label\":\"允许，因为尚未逾期。\",\"feedback\":\"尚未逾期只满足一项条件；LIB2 还要求没有其他读者预约。\"},{\"label\":\"不允许，因为预约条件不满足。\",\"feedback\":\"两个条件必须同时成立；已有预约使本次不满足完整规则。\"}],\"correctIndex\":1,\"reference\":\"本次不允许。LIB2 要求尚未逾期且没有其他读者预约，两项条件同时成立才规则允许；规则允许仍不等于已成功。\",\"sourceId\":\"renewal-rules\"},{\"id\":\"date-check\",\"type\":\"choice\",\"title\":\"Calendar Day · 核对跨月日期\",\"prompt\":\"原到期日为 2026-10-29。按 LIB3，续借成功与失败后分别何时归还？\",\"options\":[{\"label\":\"成功后为 2026-11-05；失败时仍为 2026-10-29。\",\"feedback\":\"成功从原到期日增加七个日历日，跨月仍适用；失败不改原日期。\"},{\"label\":\"成功和失败后都为 2026-11-05。\",\"feedback\":\"失败时没有日期延后；不能把成功后的效果套到失败状态。\"}],\"correctIndex\":0,\"reference\":\"成功：2026-11-05；失败：2026-10-29。日期基准是原到期日，不是申请日；增加的是七个日历日。\",\"sourceId\":\"renewal-rules\"},{\"id\":\"completion-check\",\"type\":\"choice\",\"title\":\"Completion Confirmation · 核对完成依据\",\"prompt\":\"已经点击申请，但尚未看到成功文字与更新后的归还日期。按 LIB4，此时能确认什么？\",\"options\":[{\"label\":\"已完成，因为已点击申请。\",\"feedback\":\"点击只表示申请提交，不能替代成功文字与日期更新两项确认依据。\"},{\"label\":\"已提交，结果尚不能确认；也不能据此断定失败。\",\"feedback\":\"LIB4 把提交与确认成功分开；缺少成功确认不等于已知失败。\"}],\"correctIndex\":1,\"reference\":\"只能确认申请提交。完成确认需同时有续借成功文字和更新后的归还日期；结果未确认时保留未知，不补造失败或后台步骤。\",\"sourceId\":\"renewal-rules\"}],\"sources\":[{\"id\":\"renewal-rules\",\"title\":\"Synthetic Renewal Rules · 自编续借规则\",\"path\":\"sources/renewal-rules.md\",\"locator\":\"LIB1–LIB4；本插件的合成验收材料，不是任何真实图书馆政策。\"}]}</script>\n+</body>\n+</html>"},{"sha":"cbd7908d6d6fe04089f2a1fef5aa993865bcb5e4","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/site/learning.js","status":"added","additions":102,"deletions":0,"changes":102,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Flearning.js","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Flearning.js","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Flearning.js?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,102 @@\n+/* Original, optional browser-local practice. No network, stored account or persisted grade. */\n+(() => {\n+  \"use strict\";\n+  let config;\n+  try { config = JSON.parse(document.getElementById(\"artifact-state\").textContent); }\n+  catch { return; }\n+  if (!Array.isArray(config.activities)) return;\n+  document.documentElement.classList.add(\"js\");\n+  const byID = id => document.getElementById(id);\n+  const exportField = byID(\"export-text\"), exportStatus = byID(\"export-status\"), summary = byID(\"practice-status\");\n+  const copy = document.querySelector(\"[data-copy]\"), download = document.querySelector(\"[data-download]\"), copyReturn = document.querySelector(\"[data-copy-return]\");\n+  let revision = 0, downloadURL = null;\n+  const paragraph = (target, value) => { const p = document.createElement(\"p\"); p.textContent = value; target.append(p); };\n+  const invalidate = () => {\n+    revision++;\n+    if (exportField.value) { exportField.value = \"\"; exportStatus.textContent = \"回答或核对记录已改变，请重新生成记录。\"; }\n+    copy.disabled = true;\n+    copyReturn.hidden = true;\n+    download.hidden = true; download.removeAttribute(\"href\");\n+    if (downloadURL) { URL.revokeObjectURL(downloadURL); downloadURL = null; }\n+  };\n+  const questions = config.activities.map(activity => {\n+    const form = document.querySelector(`form[data-activity=\"${activity.id}\"]`);\n+    return { activity, form, radios: Array.from(form.querySelectorAll('input[type=\"radio\"]')), feedback: form.querySelector(\"[data-feedback]\"), attempts: 0, result: null };\n+  });\n+  const selected = question => question.radios.findIndex(radio => radio.checked);\n+  const updateSummary = () => { if (summary) summary.textContent = `当前已核对 ${questions.filter(question => question.result !== null).length} / ${questions.length} 题；修改后需重新核对。`; };\n+  questions.forEach(question => {\n+    const { form, radios, feedback, activity } = question;\n+    radios.forEach(radio => { radio.setAttribute(\"aria-describedby\", feedback.id); radio.addEventListener(\"change\", () => {\n+      question.result = null; feedback.replaceChildren(); delete feedback.dataset.result;\n+      paragraph(feedback, \"回答已修改，请重新核对。\"); invalidate(); updateSummary();\n+    }); });\n+    form.addEventListener(\"submit\", event => {\n+      event.preventDefault(); feedback.replaceChildren();\n+      const index = selected(question);\n+      if (index < 0) { delete feedback.dataset.result; paragraph(feedback, \"请先选择一个判断。未选择不算回答。\"); radios[0].focus(); return; }\n+      question.attempts++;\n+      question.result = { index, matched: index === activity.correctIndex };\n+      invalidate();\n+      feedback.dataset.result = question.result.matched ? \"match\" : \"review\";\n+      paragraph(feedback, `你的选择：${activity.options[index].label}`);\n+      paragraph(feedback, question.result.matched ? \"与本题参考判断匹配。\" : \"这一判断需要复核，可以修改后重试。\");\n+      paragraph(feedback, activity.options[index].feedback);\n+      paragraph(feedback, `参考判断：${activity.reference}`);\n+      const source = document.createElement(\"a\"); source.href = `#source-${activity.sourceId}`; source.textContent = \"查看依据\"; feedback.append(source);\n+      paragraph(feedback, `本题核对 ${question.attempts} 次；记录只对应本题。`);\n+      updateSummary();\n+    });\n+  });\n+  document.querySelector(\"[data-reset]\")?.addEventListener(\"click\", () => {\n+    questions.forEach(question => { question.form.reset(); question.radios.forEach(radio => { radio.checked = false; }); question.result = null; question.attempts = 0; question.feedback.replaceChildren(); delete question.feedback.dataset.result; });\n+    byID(\"reflection\").value = \"\"; invalidate(); updateSummary();\n+    exportStatus.textContent = \"本次练习已重置。记录只在当前页面会话中。\";\n+  });\n+  byID(\"reflection\").addEventListener(\"input\", invalidate);\n+  document.querySelector(\"[data-export]\").addEventListener(\"click\", () => {\n+    invalidate();\n+    const lines = [`# ${config.title} — 本次学习记录`, \"\", `- 材料版本：${config.version}`, `- 记录时间：${new Date().toISOString()}`, `- Audience：${config.audience}`, `- Task：${config.task}`, \"- 范围：当前会话的回答与核对；理解效果 NOT_MEASURED。\", \"\"];\n+    questions.forEach(question => {\n+      const { activity, result } = question, index = selected(question);\n+      lines.push(`## ${activity.id} · ${activity.title}`, \"\", `- 题目：${activity.prompt}`, `- 当前选择：${index < 0 ? \"未选择\" : activity.options[index].label}`, `- 核对次数：${question.attempts}`, `- 本次判断：${result ? result.matched ? \"与参考匹配\" : \"需要复核\" : \"当前选择尚未核对\"}`);\n+      if (result) lines.push(`- 对应反馈：${activity.options[result.index].feedback}`);\n+      lines.push(`- 参考判断：${activity.reference}`, `- 来源 ID：${activity.sourceId}`, `- 页面回查：#source-${activity.sourceId}`, \"\");\n+    });\n+    lines.push(\"## Sources · 来源\", \"\");\n+    for (const source of config.sources || []) {\n+      lines.push(`### ${source.id} · ${source.title}`, \"\", `- 来源 ID：${source.id}`, `- 标题：${source.title}`, `- 定位：${source.locator}`);\n+      if (source.path) lines.push(`- 制品内相对路径：${source.path}`);\n+      if (source.url) lines.push(`- 来源 URL：${source.url}`);\n+      lines.push(\"\");\n+    }\n+    lines.push(\"## 应用与意见\", \"\", byID(\"reflection\").value.trim() || \"尚未填写。\", \"\", \"记录未上传、未持久化；保存导出后由你自行保留。\", \"\");\n+    exportField.value = lines.join(\"\\n\"); copy.disabled = false;\n+    if (typeof Blob !== \"undefined\" && typeof URL.createObjectURL === \"function\") { downloadURL = URL.createObjectURL(new Blob([exportField.value], { type: \"text/markdown;charset=utf-8\" })); download.href = downloadURL; download.hidden = false; }\n+    exportStatus.textContent = \"已生成记录，可复制、下载或在文本区手动复制。\";\n+  });\n+  copy.addEventListener(\"click\", async () => {\n+    if (!exportField.value) { exportStatus.textContent = \"请先生成记录。\"; return; }\n+    const started = revision, value = exportField.value;\n+    try {\n+      if (!navigator.clipboard?.writeText) throw new Error(\"clipboard unavailable\");\n+      await navigator.clipboard.writeText(value);\n+      if (started === revision) { copyReturn.hidden = true; exportStatus.textContent = \"已复制本次记录。\"; }\n+    } catch {\n+      if (started !== revision) return;\n+      copyReturn.hidden = false;\n+      exportStatus.textContent = \"自动复制未成功。已选中导出文字，请手动复制；完成或取消后可按 Escape，或用返回复制按钮离开。\";\n+      exportField.focus(); exportField.select();\n+    }\n+  });\n+  const leaveManualCopy = () => {\n+    if (copyReturn.hidden) return;\n+    copyReturn.hidden = true;\n+    exportStatus.textContent = \"已返回复制按钮；手动复制是否完成未作确认。\";\n+    copy.focus();\n+  };\n+  copyReturn.addEventListener(\"click\", leaveManualCopy);\n+  exportField.addEventListener(\"keydown\", event => { if (event.key === \"Escape\" && !copyReturn.hidden) { event.preventDefault(); leaveManualCopy(); } });\n+  window.addEventListener(\"pagehide\", () => { if (downloadURL) URL.revokeObjectURL(downloadURL); });\n+  updateSummary();\n+})();"},{"sha":"02fe842ca3981cb570fe033ebd5a9b1252ba6339","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/site/licenses/Apache-2.0.txt","status":"added","additions":201,"deletions":0,"changes":201,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Flicenses%2FApache-2.0.txt","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Flicenses%2FApache-2.0.txt","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Flicenses%2FApache-2.0.txt?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,201 @@\n+                                 Apache License\n+                           Version 2.0, January 2004\n+                        http://www.apache.org/licenses/\n+\n+   TERMS AND CONDITIONS FOR USE, REPRODUCTION, AND DISTRIBUTION\n+\n+   1. Definitions.\n+\n+      \"License\" shall mean the terms and conditions for use, reproduction,\n+      and distribution as defined by Sections 1 through 9 of this document.\n+\n+      \"Licensor\" shall mean the copyright owner or entity authorized by\n+      the copyright owner that is granting the License.\n+\n+      \"Legal Entity\" shall mean the union of the acting entity and all\n+      other entities that control, are controlled by, or are under common\n+      control with that entity. For the purposes of this definition,\n+      \"control\" means (i) the power, direct or indirect, to cause the\n+      direction or management of such entity, whether by contract or\n+      otherwise, or (ii) ownership of fifty percent (50%) or more of the\n+      outstanding shares, or (iii) beneficial ownership of such entity.\n+\n+      \"You\" (or \"Your\") shall mean an individual or Legal Entity\n+      exercising permissions granted by this License.\n+\n+      \"Source\" form shall mean the preferred form for making modifications,\n+      including but not limited to software source code, documentation\n+      source, and configuration files.\n+\n+      \"Object\" form shall mean any form resulting from mechanical\n+      transformation or translation of a Source form, including but\n+      not limited to compiled object code, generated documentation,\n+      and conversions to other media types.\n+\n+      \"Work\" shall mean the work of authorship, whether in Source or\n+      Object form, made available under the License, as indicated by a\n+      copyright notice that is included in or attached to the work\n+      (an example is provided in the Appendix below).\n+\n+      \"Derivative Works\" shall mean any work, whether in Source or Object\n+      form, that is based on (or derived from) the Work and for which the\n+      editorial revisions, annotations, elaborations, or other modifications\n+      represent, as a whole, an original work of authorship. For the purposes\n+      of this License, Derivative Works shall not include works that remain\n+      separable from, or merely link (or bind by name) to the interfaces of,\n+      the Work and Derivative Works thereof.\n+\n+      \"Contribution\" shall mean any work of authorship, including\n+      the original version of the Work and any modifications or additions\n+      to that Work or Derivative Works thereof, that is intentionally\n+      submitted to Licensor for inclusion in the Work by the copyright owner\n+      or by an individual or Legal Entity authorized to submit on behalf of\n+      the copyright owner. For the purposes of this definition, \"submitted\"\n+      means any form of electronic, verbal, or written communication sent\n+      to the Licensor or its representatives, including but not limited to\n+      communication on electronic mailing lists, source code control systems,\n+      and issue tracking systems that are managed by, or on behalf of, the\n+      Licensor for the purpose of discussing and improving the Work, but\n+      excluding communication that is conspicuously marked or otherwise\n+      designated in writing by the copyright owner as \"Not a Contribution.\"\n+\n+      \"Contributor\" shall mean Licensor and any individual or Legal Entity\n+      on behalf of whom a Contribution has been received by Licensor and\n+      subsequently incorporated within the Work.\n+\n+   2. Grant of Copyright License. Subject to the terms and conditions of\n+      this License, each Contributor hereby grants to You a perpetual,\n+      worldwide, non-exclusive, no-charge, royalty-free, irrevocable\n+      copyright license to reproduce, prepare Derivative Works of,\n+      publicly display, publicly perform, sublicense, and distribute the\n+      Work and such Derivative Works in Source or Object form.\n+\n+   3. Grant of Patent License. Subject to the terms and conditions of\n+      this License, each Contributor hereby grants to You a perpetual,\n+      worldwide, non-exclusive, no-charge, royalty-free, irrevocable\n+      (except as stated in this section) patent license to make, have made,\n+      use, offer to sell, sell, import, and otherwise transfer the Work,\n+      where such license applies only to those patent claims licensable\n+      by such Contributor that are necessarily infringed by their\n+      Contribution(s) alone or by combination of their Contribution(s)\n+      with the Work to which such Contribution(s) was submitted. If You\n+      institute patent litigation against any entity (including a\n+      cross-claim or counterclaim in a lawsuit) alleging that the Work\n+      or a Contribution incorporated within the Work constitutes direct\n+      or contributory patent infringement, then any patent licenses\n+      granted to You under this License for that Work shall terminate\n+      as of the date such litigation is filed.\n+\n+   4. Redistribution. You may reproduce and distribute copies of the\n+      Work or Derivative Works thereof in any medium, with or without\n+      modifications, and in Source or Object form, provided that You\n+      meet the following conditions:\n+\n+      (a) You must give any other recipients of the Work or\n+          Derivative Works a copy of this License; and\n+\n+      (b) You must cause any modified files to carry prominent notices\n+          stating that You changed the files; and\n+\n+      (c) You must retain, in the Source form of any Derivative Works\n+          that You distribute, all copyright, patent, trademark, and\n+          attribution notices from the Source form of the Work,\n+          excluding those notices that do not pertain to any part of\n+          the Derivative Works; and\n+\n+      (d) If the Work includes a \"NOTICE\" text file as part of its\n+          distribution, then any Derivative Works that You distribute must\n+          include a readable copy of the attribution notices contained\n+          within such NOTICE file, excluding those notices that do not\n+          pertain to any part of the Derivative Works, in at least one\n+          of the following places: within a NOTICE text file distributed\n+          as part of the Derivative Works; within the Source form or\n+          documentation, if provided along with the Derivative Works; or,\n+          within a display generated by the Derivative Works, if and\n+          wherever such third-party notices normally appear. The contents\n+          of the NOTICE file are for informational purposes only and\n+          do not modify the License. You may add Your own attribution\n+          notices within Derivative Works that You distribute, alongside\n+          or as an addendum to the NOTICE text from the Work, provided\n+          that such additional attribution notices cannot be construed\n+          as modifying the License.\n+\n+      You may add Your own copyright statement to Your modifications and\n+      may provide additional or different license terms and conditions\n+      for use, reproduction, or distribution of Your modifications, or\n+      for any such Derivative Works as a whole, provided Your use,\n+      reproduction, and distribution of the Work otherwise complies with\n+      the conditions stated in this License.\n+\n+   5. Submission of Contributions. Unless You explicitly state otherwise,\n+      any Contribution intentionally submitted for inclusion in the Work\n+      by You to the Licensor shall be under the terms and conditions of\n+      this License, without any additional terms or conditions.\n+      Notwithstanding the above, nothing herein shall supersede or modify\n+      the terms of any separate license agreement you may have executed\n+      with Licensor regarding such Contributions.\n+\n+   6. Trademarks. This License does not grant permission to use the trade\n+      names, trademarks, service marks, or product names of the Licensor,\n+      except as required for reasonable and customary use in describing the\n+      origin of the Work and reproducing the content of the NOTICE file.\n+\n+   7. Disclaimer of Warranty. Unless required by applicable law or\n+      agreed to in writing, Licensor provides the Work (and each\n+      Contributor provides its Contributions) on an \"AS IS\" BASIS,\n+      WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or\n+      implied, including, without limitation, any warranties or conditions\n+      of TITLE, NON-INFRINGEMENT, MERCHANTABILITY, or FITNESS FOR A\n+      PARTICULAR PURPOSE. You are solely responsible for determining the\n+      appropriateness of using or redistributing the Work and assume any\n+      risks associated with Your exercise of permissions under this License.\n+\n+   8. Limitation of Liability. In no event and under no legal theory,\n+      whether in tort (including negligence), contract, or otherwise,\n+      unless required by applicable law (such as deliberate and grossly\n+      negligent acts) or agreed to in writing, shall any Contributor be\n+      liable to You for damages, including any direct, indirect, special,\n+      incidental, or consequential damages of any character arising as a\n+      result of this License or out of the use or inability to use the\n+      Work (including but not limited to damages for loss of goodwill,\n+      work stoppage, computer failure or malfunction, or any and all\n+      other commercial damages or losses), even if such Contributor\n+      has been advised of the possibility of such damages.\n+\n+   9. Accepting Warranty or Additional Liability. While redistributing\n+      the Work or Derivative Works thereof, You may choose to offer,\n+      and charge a fee for, acceptance of support, warranty, indemnity,\n+      or other liability obligations and/or rights consistent with this\n+      License. However, in accepting such obligations, You may act only\n+      on Your own behalf and on Your sole responsibility, not on behalf\n+      of any other Contributor, and only if You agree to indemnify,\n+      defend, and hold each Contributor harmless for any liability\n+      incurred by, or claims asserted against, such Contributor by reason\n+      of your accepting any such warranty or additional liability.\n+\n+   END OF TERMS AND CONDITIONS\n+\n+   APPENDIX: How to apply the Apache License to your work.\n+\n+      To apply the Apache License to your work, attach the following\n+      boilerplate notice, with the fields enclosed by brackets \"[]\"\n+      replaced with your own identifying information. (Don't include\n+      the brackets!)  The text should be enclosed in the appropriate\n+      comment syntax for the file format. We also recommend that a\n+      file or class name and description of purpose be included on the\n+      same \"printed page\" as the copyright notice for easier\n+      identification within third-party archives.\n+\n+   Copyright 2026 Anthropic PBC\n+\n+   Licensed under the Apache License, Version 2.0 (the \"License\");\n+   you may not use this file except in compliance with the License.\n+   You may obtain a copy of the License at\n+\n+       http://www.apache.org/licenses/LICENSE-2.0\n+\n+   Unless required by applicable law or agreed to in writing, software\n+   distributed under the License is distributed on an \"AS IS\" BASIS,\n+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n+   See the License for the specific language governing permissions and\n+   limitations under the License."},{"sha":"4d29ba6bdda373a719519d6a271e242ec78fa992","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/site/sources/renewal-rules.md","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Fsources%2Frenewal-rules.md","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Fsources%2Frenewal-rules.md","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Fsources%2Frenewal-rules.md?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,21 @@\n+# Synthetic Renewal Rules · 自编续借规则\n+\n+这些规则由本插件为代表性合成验收编写，不是任何真实图书馆政策，不授权或执行真实续借。\n+\n+## LIB1 · Scope\n+\n+本练习只处理一本书的一次续借。账户信息“当前借阅”“预约记录”“借阅历史”为并列分类，不表示办理顺序。\n+\n+## LIB2 · Permission\n+\n+书尚未逾期，且没有其他读者预约时，可以续借；任一条件不满足，就不能按这条规则续借。“可以续借”表示规则允许，成功仍须按 LIB4 确认。\n+\n+## LIB3 · Due Date\n+\n+续借成功后，归还日期在原到期日基础上延后七个日历日；续借失败时，原到期日不变。\n+\n+## LIB4 · Confirmation\n+\n+点击“申请续借”只表示申请提交。页面显示“续借成功”并更新归还日期后，才能确认续借完成。\n+\n+没有成功确认不等于已确认失败。规则未提供完整后台状态机或等待时长，不据此补造审批步骤或超时失败。"},{"sha":"e4f6272bc65bf337fc0bb949405df17f66a674df","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/site/theme.css","status":"added","additions":113,"deletions":0,"changes":113,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Ftheme.css","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Ftheme.css","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Fsite%2Ftheme.css?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,113 @@\n+:root {\n+  color-scheme: light;\n+  --paper: #faf9f5;\n+  --ink: #252521;\n+  --body: #42423c;\n+  --clay: #b45a3b;\n+  --deep-clay: #93442c;\n+  --wash: #f0ece2;\n+  --line: #d6d1c5;\n+  --serif: Georgia, \"Times New Roman\", \"Songti SC\", serif;\n+  --sans: system-ui, -apple-system, \"Segoe UI\", \"Microsoft YaHei\", sans-serif;\n+}\n+* { box-sizing: border-box; }\n+html { scroll-padding-top: 1.5rem; }\n+body { margin: 0; background: var(--paper); color: var(--body); font: 1rem/1.85 var(--sans); }\n+a { color: var(--deep-clay); text-underline-offset: .25em; overflow-wrap: anywhere; }\n+a:hover { color: #6f301c; }\n+button, input, textarea { font: inherit; }\n+button, summary, input, a { touch-action: manipulation; }\n+button { min-height: 44px; padding: .5rem 1rem; border: 1px solid var(--deep-clay); border-radius: .4rem; background: var(--deep-clay); color: #fff; cursor: pointer; }\n+button:hover { background: #74351f; }\n+button:disabled { opacity: .6; cursor: default; }\n+:focus-visible { outline: 3px solid var(--deep-clay); outline-offset: 4px; }\n+[hidden] { display: none !important; }\n+.paper { max-width: 980px; margin: auto; padding: 1.5rem 3rem 0; }\n+.masthead { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--line); color: var(--deep-clay); font-size: .8rem; }\n+.masthead p { margin: 0 0 1rem; }\n+main > section { padding: 2.5rem 0; border-bottom: 1px solid var(--line); }\n+h1, h2, h3, h4, h5 { font-family: var(--serif); font-weight: 500; line-height: 1.3; color: var(--ink); overflow-wrap: anywhere; }\n+h1 { font-size: clamp(2rem, 5vw, 3.7rem); margin: .6rem 0 1.5rem; letter-spacing: -.03em; text-wrap: balance; }\n+h2 { font-size: 1.9rem; margin: 2rem 0 1rem; }\n+h3 { font-size: 1.45rem; margin: 1.5rem 0 .8rem; }\n+h4 { font-size: 1.2rem; }\n+p, ul, ol, dl { margin: 0 0 1rem; }\n+li { margin: .35rem 0; }\n+dt { color: var(--ink); font-weight: 650; }\n+dd { margin: 0 0 1rem; }\n+.eyebrow { color: var(--deep-clay); font-size: .8rem; letter-spacing: .12em; }\n+.scope { padding: 1rem 1.2rem; border-left: 3px solid var(--clay); background: var(--wash); font-size: .9rem; }\n+.reading { max-width: 100%; }\n+.reading > p { max-width: 76ch; }\n+.reading h1 { font-size: 2.25rem; }\n+.reading h2:first-child { margin-top: 0; }\n+code { font: .9em/1.65 ui-monospace, Consolas, monospace; background: var(--wash); padding: .1em .3em; border-radius: .2rem; overflow-wrap: anywhere; }\n+pre { max-width: 100%; overflow-x: auto; padding: 1rem; background: var(--wash); border: 1px solid var(--line); border-radius: .4rem; }\n+pre code { padding: 0; background: transparent; overflow-wrap: normal; white-space: pre; }\n+hr { border: 0; border-top: 1px solid var(--line); margin: 2rem 0; }\n+.table-scroll { max-width: 100%; overflow-x: auto; margin: 1.5rem 0; border: 1px solid var(--line); border-radius: .4rem; }\n+table { border-collapse: collapse; width: 100%; font-size: .9rem; }\n+th, td { text-align: left; vertical-align: top; padding: .8rem 1rem; border-bottom: 1px solid var(--line); overflow-wrap: anywhere; }\n+th { color: var(--ink); background: var(--wash); }\n+tr:last-child td { border-bottom: 0; }\n+.terms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem 1.5rem; }\n+.terms > div { padding: .8rem 1rem; background: var(--wash); }\n+.terms dd { margin: .25rem 0 0; }\n+.activity { margin: 1.2rem 0; padding: 1.5rem; border: 1px solid var(--line); border-radius: .6rem; background: #fff; }\n+.activity h3 { margin-top: 0; }\n+.scenario { padding-left: 1rem; border-left: 2px solid var(--clay); }\n+fieldset { padding: 0; margin: 1rem 0; border: 0; min-width: 0; }\n+legend { font-weight: 650; color: var(--ink); margin-bottom: .5rem; }\n+.option { display: flex; gap: .7rem; align-items: flex-start; padding: .8rem; margin: .5rem 0; border: 1px solid var(--line); border-radius: .4rem; cursor: pointer; }\n+.option input { margin: .4rem 0 0; flex-shrink: 0; accent-color: var(--deep-clay); }\n+.option:has(input:checked) { border-color: var(--clay); background: var(--wash); }\n+.option span { min-width: 0; overflow-wrap: anywhere; }\n+[data-feedback]:not(:empty) { background: var(--wash); margin-top: 1rem; padding: 1rem; border-radius: .4rem; }\n+[data-feedback] p:last-child { margin-bottom: 0; }\n+details { margin-top: 1rem; padding: .5rem 1rem 1rem; border: 1px solid var(--line); border-radius: .4rem; }\n+summary { color: var(--deep-clay); padding: .4rem 0; cursor: pointer; }\n+details[open] > summary { margin-bottom: .5rem; }\n+textarea { display: block; width: 100%; max-width: 100%; min-height: 8rem; margin: .6rem 0 1rem; padding: .8rem; border: 1px solid #767676; border-radius: .4rem; resize: vertical; background: #fff; color: var(--ink); }\n+.enhancement { display: none; }\n+.js button.enhancement, .js .enhancement { display: block; }\n+.js .practice-controls, .js .export-controls { display: flex; align-items: center; flex-wrap: wrap; gap: .8rem; }\n+.practice-controls p { margin: 0; }\n+.export-box { margin-top: 1rem; }\n+#export-text { font: .85rem/1.7 ui-monospace, Consolas, monospace; }\n+#export-status { min-height: 1.8em; }\n+.sources li { margin: 1rem 0; padding-left: .4rem; }\n+.sources p { margin: .2rem 0; }\n+footer { padding: 1.7rem 0; font-size: .8rem; }\n+.skip-link { position: absolute; left: 1rem; top: 1rem; transform: translateY(-250%); background: #fff; padding: .7rem 1rem; z-index: 5; }\n+.skip-link:focus { transform: none; }\n+@media (max-width: 640px) {\n+  .paper { padding: 1.2rem 1.2rem 0; }\n+  main > section { padding: 1.7rem 0; }\n+  h2 { font-size: 1.65rem; }\n+  .terms { grid-template-columns: 1fr; }\n+  .activity { padding: 1rem; }\n+  th, td { padding: .6rem .7rem; }\n+}\n+@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }\n+@media print {\n+  body { background: #fff; color: #000; }\n+  .paper { max-width: none; padding: 0; }\n+  .skip-link, button, .export-controls, .export-box, .practice-controls { display: none !important; }\n+  .table-scroll, pre { overflow: visible; }\n+  .activity { break-inside: avoid; }\n+  a { color: inherit; }\n+}\n+\n+/* Built-in neutral theme */\n+:root {\n+  --paper: #fafafa;\n+  --ink: #222222;\n+  --body: #3d3d3d;\n+  --clay: #595959;\n+  --deep-clay: #404040;\n+  --wash: #f0f0f0;\n+  --line: #767676;\n+  --serif: var(--sans);\n+}\n+a:hover { color: #262626; }\n+button:hover { background: #26262