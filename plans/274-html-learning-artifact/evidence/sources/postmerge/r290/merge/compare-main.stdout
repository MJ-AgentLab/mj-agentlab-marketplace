orktrees\\\\html-prompt-alignment\\\\develop\\\\plugins\\\\html-guide-kit\\\\skills\\\\site\\\\scripts\\\\check_artifact.py\",\n+        \"--input\",\n+        \"C:\\\\Users\\\\Admin\\\\.codex\\\\worktrees\\\\html-prompt-alignment\\\\alignment-evidence\\\\local-delivery\\\\run-independent-r1\\\\site\",\n+        \"--output\",\n+        \"C:\\\\Users\\\\Admin\\\\.codex\\\\worktrees\\\\html-prompt-alignment\\\\alignment-evidence\\\\local-delivery\\\\run-independent-r1\\\\static-report.json\"\n+      ],\n+      \"cwd\": \"C:\\\\Users\\\\Admin\\\\.codex\\\\worktrees\\\\html-prompt-alignment\\\\alignment-evidence\\\\local-delivery\\\\run-independent-r1\",\n+      \"startedAt\": \"2026-10-20T06:23:55.066Z\",\n+      \"endedAt\": \"2026-10-20T06:23:55.148Z\",\n+      \"exitCode\": 0,\n+      \"signal\": null,\n+      \"error\": null,\n+      \"stdout\": \"02-static.stdout.txt\",\n+      \"stderr\": \"02-static.stderr.txt\"\n+    },\n+    {\n+      \"id\": \"03-renderings\",\n+      \"executable\": \"C:/Users/Admin/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe\",\n+      \"args\": [\n+        \"C:\\\\Users\\\\Admin\\\\.codex\\\\worktrees\\\\html-prompt-alignment\\\\develop\\\\plugins\\\\html-guide-kit\\\\skills\\\\site\\\\scripts\\\\check_renderings.py\",\n+        \"--input\",\n+        \"C:\\\\Users\\\\Admin\\\\.codex\\\\worktrees\\\\html-prompt-alignment\\\\alignment-evidence\\\\local-delivery\\\\run-independent-r1\\\\site\",\n+        \"--screenshots\",\n+        \"C:\\\\Users\\\\Admin\\\\.codex\\\\worktrees\\\\html-prompt-alignment\\\\alignment-evidence\\\\local-delivery\\\\run-independent-r1\\\\screenshots\",\n+        \"--output\",\n+        \"C:\\\\Users\\\\Admin\\\\.codex\\\\worktrees\\\\html-prompt-alignment\\\\alignment-evidence\\\\local-delivery\\\\run-independent-r1\\\\browser-report.json\"\n+      ],\n+      \"cwd\": \"C:\\\\Users\\\\Admin\\\\.codex\\\\worktrees\\\\html-prompt-alignment\\\\alignment-evidence\\\\local-delivery\\\\run-independent-r1\",\n+      \"startedAt\": \"2026-10-20T06:23:55.148Z\",\n+      \"endedAt\": \"2026-10-20T06:23:55.956Z\",\n+      \"exitCode\": 0,\n+      \"signal\": null,\n+      \"error\": null,\n+      \"stdout\": \"03-renderings.stdout.txt\",\n+      \"stderr\": \"03-renderings.stderr.txt\"\n+    }\n+  ],\n+  \"limitations\": [\n+    \"No actual Matt interview or native question\",\n+    \"No Sites, CLI model or desktop matrix\",\n+    \"Browser checker is bounded layout only; screenshot review separately recorded\",\n+    \"No answer/copy/export/reset/keyboard/touch operations performed by this script\",\n+    \"Effects NOT_MEASURED; protected approval/Owner acceptance independent\"\n+  ]\n+}"},{"sha":"75093b9ba2b645ae0e2718d39b1a234ac9d7da97","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/final-result.json","status":"added","additions":66,"deletions":0,"changes":66,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Ffinal-result.json","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Ffinal-result.json","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Ffinal-result.json?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,66 @@\n+{\n+  \"schemaVersion\": 1,\n+  \"reviewer\": \"/root/alignment_independent_review\",\n+  \"recordedAt\": \"2026-10-20T06:25:31.804Z\",\n+  \"role\": \"Independent Agent actually completing one synthetic already-confirmed local-delivery scene\",\n+  \"candidate\": \"b5b8300ae58e967e1d0013e66dc4f1208ac860ef\",\n+  \"contentVersion\": \"synthetic-1.0\",\n+  \"mode\": \"local-only\",\n+  \"theme\": \"neutral\",\n+  \"delivery\": {\n+    \"html\": \"site/index.html\",\n+    \"independentInput\": \"input/\",\n+    \"standaloneContent\": \"site/content.md\",\n+    \"fullSource\": \"site/sources/renewal-rules.md\",\n+    \"metadata\": \"site/artifact.json\",\n+    \"outputFileManifest\": \"site/artifact-manifest.json\",\n+    \"instructions\": \"DELIVERY.md\",\n+    \"replay\": \"../replay.mjs\"\n+  },\n+  \"actualResults\": {\n+    \"generateExit\": 0,\n+    \"staticExit\": 0,\n+    \"staticChecks\": {\n+      \"checks\": 96,\n+      \"failed\": 0,\n+      \"pages\": 1,\n+      \"files\": 9\n+    },\n+    \"browserExit\": 0,\n+    \"browserStatus\": \"PASS\",\n+    \"viewports\": [\n+      {\n+        \"viewport\": {\n+          \"width\": 1366,\n+          \"height\": 900\n+        },\n+        \"status\": \"PASS\"\n+      },\n+      {\n+        \"viewport\": {\n+          \"width\": 390,\n+          \"height\": 844\n+        },\n+        \"status\": \"PASS\"\n+      }\n+    ],\n+    \"screenshotReview\": \"Both actual run PNGs viewed\",\n+    \"sourceAndSkillUnchanged\": true,\n+    \"semanticReview\": \"PASS_BOUNDED_SEMANTIC_REVIEW\",\n+    \"exactRecovery\": \"PASS_EXACT_REGENERATION\"\n+  },\n+  \"result\": \"PASS_BOUNDED_CONFIRMED_LOCAL_DELIVERY\",\n+  \"completionBoundary\": \"Requested local artifact, independent content/source/version, actual limited checks and regeneration instructions delivered. This is not full plugin release acceptance or exhaustive artifact interaction acceptance.\",\n+  \"notExecuted\": [\n+    \"Actual Matt interview or unanswered-question behavior\",\n+    \"Native window persistence/close/timeout\",\n+    \"Sites creation/save/deploy or remote access check\",\n+    \"CLI model/desktop/second client\",\n+    \"This Agent answer/copy/export/reset/keyboard operations\",\n+    \"Full npm/13-install matrix\",\n+    \"Understanding effects\"\n+  ],\n+  \"nativeWindow\": \"DEFERRED\",\n+  \"understandingEffects\": \"NOT_MEASURED\",\n+  \"ownerAcceptance\": \"NOT_PROVIDED; no synthetic role substitute\"\n+}"},{"sha":"d6d0f889354411fdc2342e376c4a5bd4adf88e26","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/input/artifact.json","status":"added","additions":105,"deletions":0,"changes":105,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Finput%2Fartifact.json","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Finput%2Fartifact.json","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Finput%2Fartifact.json?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,105 @@\n+{\n+  \"schemaVersion\": 1,\n+  \"title\": \"Library Renewal · 续借判断学习制品\",\n+  \"version\": \"synthetic-1.0\",\n+  \"audience\": \"能够读懂基本日期，但尚未区分规则许可、申请提交与完成确认的学习者。\",\n+  \"task\": \"根据本页自编规则，解释续借是否允许、成功或失败后的日期，以及确认完成所需依据。\",\n+  \"goals\": [\n+    \"用两个必要条件的组合解释规则许可，不把且改为或。\",\n+    \"从原到期日计算成功后的七个日历日，失败时保留原日期。\",\n+    \"区分提交、成功确认与未知结果，并指出确认所需的两项依据。\"\n+  ],\n+  \"markdown\": \"content.md\",\n+  \"sources\": [\n+    {\n+      \"id\": \"renewal-rules\",\n+      \"title\": \"Synthetic Renewal Rules · 自编续借规则\",\n+      \"path\": \"sources/renewal-rules.md\",\n+      \"locator\": \"LIB1–LIB4；本插件的合成验收材料，不是任何真实图书馆政策。\"\n+    }\n+  ],\n+  \"terms\": [\n+    {\n+      \"english\": \"Rule Permission\",\n+      \"chinese\": \"规则许可\",\n+      \"forbidden\": [\n+        \"规则批准\"\n+      ]\n+    },\n+    {\n+      \"english\": \"Submission\",\n+      \"chinese\": \"申请提交\"\n+    },\n+    {\n+      \"english\": \"Completion Confirmation\",\n+      \"chinese\": \"完成确认\"\n+    },\n+    {\n+      \"english\": \"Calendar Day\",\n+      \"chinese\": \"日历日\",\n+      \"forbidden\": [\n+        \"工作天\"\n+      ]\n+    }\n+  ],\n+  \"activities\": [\n+    {\n+      \"id\": \"permission-check\",\n+      \"type\": \"choice\",\n+      \"title\": \"Rule Permission · 核对规则许可\",\n+      \"prompt\": \"一本书尚未逾期，但已有其他读者预约。按 LIB2，本次是否允许续借？\",\n+      \"options\": [\n+        {\n+          \"label\": \"允许，因为尚未逾期。\",\n+          \"feedback\": \"尚未逾期只满足一项条件；LIB2 还要求没有其他读者预约。\"\n+        },\n+        {\n+          \"label\": \"不允许，因为预约条件不满足。\",\n+          \"feedback\": \"两个条件必须同时成立；已有预约使本次不满足完整规则。\"\n+        }\n+      ],\n+      \"correctIndex\": 1,\n+      \"reference\": \"本次不允许。LIB2 要求尚未逾期且没有其他读者预约，两项条件同时成立才规则允许；规则允许仍不等于已成功。\",\n+      \"sourceId\": \"renewal-rules\"\n+    },\n+    {\n+      \"id\": \"date-check\",\n+      \"type\": \"choice\",\n+      \"title\": \"Calendar Day · 核对跨月日期\",\n+      \"prompt\": \"原到期日为 2026-10-29。按 LIB3，续借成功与失败后分别何时归还？\",\n+      \"options\": [\n+        {\n+          \"label\": \"成功后为 2026-11-05；失败时仍为 2026-10-29。\",\n+          \"feedback\": \"成功从原到期日增加七个日历日，跨月仍适用；失败不改原日期。\"\n+        },\n+        {\n+          \"label\": \"成功和失败后都为 2026-11-05。\",\n+          \"feedback\": \"失败时没有日期延后；不能把成功后的效果套到失败状态。\"\n+        }\n+      ],\n+      \"correctIndex\": 0,\n+      \"reference\": \"成功：2026-11-05；失败：2026-10-29。日期基准是原到期日，不是申请日；增加的是七个日历日。\",\n+      \"sourceId\": \"renewal-rules\"\n+    },\n+    {\n+      \"id\": \"completion-check\",\n+      \"type\": \"choice\",\n+      \"title\": \"Completion Confirmation · 核对完成依据\",\n+      \"prompt\": \"已经点击申请，但尚未看到成功文字与更新后的归还日期。按 LIB4，此时能确认什么？\",\n+      \"options\": [\n+        {\n+          \"label\": \"已完成，因为已点击申请。\",\n+          \"feedback\": \"点击只表示申请提交，不能替代成功文字与日期更新两项确认依据。\"\n+        },\n+        {\n+          \"label\": \"已提交，结果尚不能确认；也不能据此断定失败。\",\n+          \"feedback\": \"LIB4 把提交与确认成功分开；缺少成功确认不等于已知失败。\"\n+        }\n+      ],\n+      \"correctIndex\": 1,\n+      \"reference\": \"只能确认申请提交。完成确认需同时有续借成功文字和更新后的归还日期；结果未确认时保留未知，不补造失败或后台步骤。\",\n+      \"sourceId\": \"renewal-rules\"\n+    }\n+  ],\n+  \"theme\": \"neutral\"\n+}"},{"sha":"4abaf6a89085af9ff0dc3765cdb079255595985e","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/input/content.md","status":"added","additions":45,"deletions":0,"changes":45,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Finput%2Fcontent.md","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Finput%2Fcontent.md","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Finput%2Fcontent.md?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,45 @@\n+# Overview · 先区分三个判断\n+\n+本材料使用项目自编的图书续借规则，帮助核对条件、日期与完成依据。它不是任何真实图书馆政策，不连接图书馆或提交真实申请。\n+\n+**Rule Permission**（规则许可）说明规则是否允许本次续借。**Submission**（申请提交）说明已提出申请。**Completion Confirmation**（完成确认）说明哪些可见依据足以确认成功；三个判断不能互相代替。\n+\n+## Necessary Foundations · 条件与日历日\n+\n+本练习只处理一本书的一次续借。两项条件用“且”连接，表示必须同时成立，不能满足一项就视为全部满足。**Calendar Day**（日历日）按连续日期计算，周末和跨月也计入。\n+\n+完整原件在 [Synthetic Renewal Rules](sources/renewal-rules.md)，以下解释对应 LIB2–LIB4。\n+\n+## Rule Permission · 同时核对两项条件\n+\n+尚未逾期且没有其他读者预约时，本练习规则允许续借。任一条件不满足，就不能按这条规则续借。规则允许不表示申请已经成功。\n+\n+| 尚未逾期 | 没有其他读者预约 | LIB2 的规则许可 |\n+| --- | --- | --- |\n+| 是 | 是 | 允许，但成功仍须按 LIB4 确认 |\n+| 是 | 否 | 不允许 |\n+| 否 | 是 | 不允许 |\n+| 否 | 否 | 不允许 |\n+\n+比较时同时查看四种组合。表格呈现条件组合，不表示先后办理步骤。\n+\n+## Date Outcome · 从原到期日计算\n+\n+按 LIB3，续借成功后，归还日期在原到期日基础上延后七个日历日；续借失败时，原到期日不变。\n+\n+- 原到期日 2026-10-20：成功后为 2026-10-27；失败时仍为 2026-10-20。\n+- 原到期日 2026-10-29：成功后为 2026-11-05；失败时仍为 2026-10-29。\n+\n+规则没有用申请日计算，也没有排除周末。日期结果需要已知成功或失败；结果未知时，不能自行选择其中一种结果来改写到期日。\n+\n+## Completion Confirmation · 保留未知结果\n+\n+按 LIB4，点击“申请续借”只表示申请提交。页面显示“续借成功”并更新归还日期后，才能确认续借完成，两项依据必须同时出现。\n+\n+没有成功确认不等于已确认失败。规则未提供完整后台状态机，也没有说明等待时长；不要自行补造审批步骤或超时失败。\n+\n+## Integrated Practice · 说明你的判断\n+\n+阅读下面的局部练习时，可以回查正文与来源。先写清当前给定条件，再解释规则、日期和完成状态分别能确认什么。修改答案后重新核对，不能沿用旧反馈。\n+\n+核对与反馈只对应这些教学题。页面可操作或一次答对，不能证明长期掌握、迁移能力或设计改善了理解；Understanding Effects 保持 NOT_MEASURED。"},{"sha":"4d29ba6bdda373a719519d6a271e242ec78fa992","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/input/sources/renewal-rules.md","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Finput%2Fsources%2Frenewal-rules.md","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Finput%2Fsources%2Frenewal-rules.md","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Finput%2Fsources%2Frenewal-rules.md?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,21 @@\n+# Synthetic Renewal Rules · 自编续借规则\n+\n+这些规则由本插件为代表性合成验收编写，不是任何真实图书馆政策，不授权或执行真实续借。\n+\n+## LIB1 · Scope\n+\n+本练习只处理一本书的一次续借。账户信息“当前借阅”“预约记录”“借阅历史”为并列分类，不表示办理顺序。\n+\n+## LIB2 · Permission\n+\n+书尚未逾期，且没有其他读者预约时，可以续借；任一条件不满足，就不能按这条规则续借。“可以续借”表示规则允许，成功仍须按 LIB4 确认。\n+\n+## LIB3 · Due Date\n+\n+续借成功后，归还日期在原到期日基础上延后七个日历日；续借失败时，原到期日不变。\n+\n+## LIB4 · Confirmation\n+\n+点击“申请续借”只表示申请提交。页面显示“续借成功”并更新归还日期后，才能确认续借完成。\n+\n+没有成功确认不等于已确认失败。规则未提供完整后台状态机或等待时长，不据此补造审批步骤或超时失败。"},{"sha":"c83a593d3bd81e7543ad66ec15c5963c734d03bc","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/recovery-check/result.json","status":"added","additions":123,"deletions":0,"changes":123,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fresult.json","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fresult.json","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fresult.json?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,123 @@\n+{\n+  \"startedAt\": \"2026-10-20T06:25:31.697Z\",\n+  \"endedAt\": \"2026-10-20T06:25:31.776Z\",\n+  \"executable\": \"D:\\\\Development\\\\nodejs\\\\node.exe\",\n+  \"args\": [\n+    \"C:\\\\Users\\\\Admin\\\\.codex\\\\worktrees\\\\html-prompt-alignment\\\\develop\\\\plugins\\\\html-guide-kit\\\\skills\\\\site\\\\scripts\\\\render-site.mjs\",\n+    \"--input\",\n+    \"C:\\\\Users\\\\Admin\\\\.codex\\\\worktrees\\\\html-prompt-alignment\\\\alignment-evidence\\\\local-delivery\\\\run-independent-r1\\\\input\",\n+    \"--output\",\n+    \"C:\\\\Users\\\\Admin\\\\.codex\\\\worktrees\\\\html-prompt-alignment\\\\alignment-evidence\\\\local-delivery\\\\run-independent-r1\\\\recovery-check\\\\site-regenerated\"\n+  ],\n+  \"cwd\": \"C:\\\\Users\\\\Admin\\\\.codex\\\\worktrees\\\\html-prompt-alignment\\\\alignment-evidence\\\\local-delivery\\\\run-independent-r1\\\\recovery-check\",\n+  \"exitCode\": 0,\n+  \"stdout\": \"recovery-check/stdout.txt\",\n+  \"stderr\": \"recovery-check/stderr.txt\",\n+  \"original\": [\n+    {\n+      \"path\": \"artifact-manifest.json\",\n+      \"bytes\": 1539,\n+      \"sha256\": \"d0799ac524e9bb38db3baf662a27db74ffc871cec0b19c5acac87b9ebb9391aa\"\n+    },\n+    {\n+      \"path\": \"artifact.json\",\n+      \"bytes\": 4077,\n+      \"sha256\": \"c80fdc5fbd113257d43779f67a783017b65a69f8318bb1405800f3c03352e44f\"\n+    },\n+    {\n+      \"path\": \"content.md\",\n+      \"bytes\": 2751,\n+      \"sha256\": \"060045ce718168c7f3c2aecd2742518490d5693e3dbdeb28b4ac94ce2885cd50\"\n+    },\n+    {\n+      \"path\": \"index.html\",\n+      \"bytes\": 13298,\n+      \"sha256\": \"12101458fb0d6d58bf902b8497feb73b742d3cec4e3409255fd07c7984de3785\"\n+    },\n+    {\n+      \"path\": \"learning.js\",\n+      \"bytes\": 7378,\n+      \"sha256\": \"1fcc8c6064dd99f00b91103cf76e33d7a4e6dcf50793b4542bd8462f6c91f568\"\n+    },\n+    {\n+      \"path\": \"LICENSE\",\n+      \"bytes\": 1068,\n+      \"sha256\": \"cfd483b2cc03452033bbc34d6ceabcc46d9917539070f6721d671705926a2a8d\"\n+    },\n+    {\n+      \"path\": \"licenses/Apache-2.0.txt\",\n+      \"bytes\": 11343,\n+      \"sha256\": \"30deeaa611125310673e7c14b4892fb102fb56697ecfab3b49b77ca0190de7e1\"\n+    },\n+    {\n+      \"path\": \"sources/renewal-rules.md\",\n+      \"bytes\": 1011,\n+      \"sha256\": \"2a95c4d9b95f3b184fea30aa3fba9daaf34d11624bd888ed4793a0ea7f96af47\"\n+    },\n+    {\n+      \"path\": \"theme.css\",\n+      \"bytes\": 6313,\n+      \"sha256\": \"32c88191ef5e0c5e97668f22c6571d3f27d10ae76458ebdc31db6240b309f835\"\n+    },\n+    {\n+      \"path\": \"THIRD_PARTY_NOTICES.md\",\n+      \"bytes\": 1944,\n+      \"sha256\": \"85d44b9273c04eda33d5f739f01cf4994fb8aeedb186955f5d7cd3336dd5e65e\"\n+    }\n+  ],\n+  \"regenerated\": [\n+    {\n+      \"path\": \"artifact-manifest.json\",\n+      \"bytes\": 1539,\n+      \"sha256\": \"d0799ac524e9bb38db3baf662a27db74ffc871cec0b19c5acac87b9ebb9391aa\"\n+    },\n+    {\n+      \"path\": \"artifact.json\",\n+      \"bytes\": 4077,\n+      \"sha256\": \"c80fdc5fbd113257d43779f67a783017b65a69f8318bb1405800f3c03352e44f\"\n+    },\n+    {\n+      \"path\": \"content.md\",\n+      \"bytes\": 2751,\n+      \"sha256\": \"060045ce718168c7f3c2aecd2742518490d5693e3dbdeb28b4ac94ce2885cd50\"\n+    },\n+    {\n+      \"path\": \"index.html\",\n+      \"bytes\": 13298,\n+      \"sha256\": \"12101458fb0d6d58bf902b8497feb73b742d3cec4e3409255fd07c7984de3785\"\n+    },\n+    {\n+      \"path\": \"learning.js\",\n+      \"bytes\": 7378,\n+      \"sha256\": \"1fcc8c6064dd99f00b91103cf76e33d7a4e6dcf50793b4542bd8462f6c91f568\"\n+    },\n+    {\n+      \"path\": \"LICENSE\",\n+      \"bytes\": 1068,\n+      \"sha256\": \"cfd483b2cc03452033bbc34d6ceabcc46d9917539070f6721d671705926a2a8d\"\n+    },\n+    {\n+      \"path\": \"licenses/Apache-2.0.txt\",\n+      \"bytes\": 11343,\n+      \"sha256\": \"30deeaa611125310673e7c14b4892fb102fb56697ecfab3b49b77ca0190de7e1\"\n+    },\n+    {\n+      \"path\": \"sources/renewal-rules.md\",\n+      \"bytes\": 1011,\n+      \"sha256\": \"2a95c4d9b95f3b184fea30aa3fba9daaf34d11624bd888ed4793a0ea7f96af47\"\n+    },\n+    {\n+      \"path\": \"theme.css\",\n+      \"bytes\": 6313,\n+      \"sha256\": \"32c88191ef5e0c5e97668f22c6571d3f27d10ae76458ebdc31db6240b309f835\"\n+    },\n+    {\n+      \"path\": \"THIRD_PARTY_NOTICES.md\",\n+      \"bytes\": 1944,\n+      \"sha256\": \"85d44b9273c04eda33d5f739f01cf4994fb8aeedb186955f5d7cd3336dd5e65e\"\n+    }\n+  ],\n+  \"allTenFilesByteIdentical\": true,\n+  \"result\": \"PASS_EXACT_REGENERATION\",\n+  \"limits\": \"Fresh independent regeneration from delivered input, not production Site rollback or browser rerun. Existing checked byte-identical artifact evidence is reused only for identical bytes.\"\n+}"},{"sha":"5ce28e0a42b9f781087df184517daafa2f483602","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/recovery-check/site-regenerated/LICENSE","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2FLICENSE","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2FLICENSE","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2FLICENSE?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,21 @@\n+MIT License\n+\n+Copyright (c) 2026 MJ-AgentLab\n+\n+Permission is hereby granted, free of charge, to any person obtaining a copy\n+of this software and associated documentation files (the \"Software\"), to deal\n+in the Software without restriction, including without limitation the rights\n+to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n+copies of the Software, and to permit persons to whom the Software is\n+furnished to do so, subject to the following conditions:\n+\n+The above copyright notice and this permission notice shall be included in all\n+copies or substantial portions of the Software.\n+\n+THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n+IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n+FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n+AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n+LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n+OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n+SOFTWARE."},{"sha":"a3cbb39433058905dbd4957143ff96bf2c480085","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/recovery-check/site-regenerated/THIRD_PARTY_NOTICES.md","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2FTHIRD_PARTY_NOTICES.md","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2FTHIRD_PARTY_NOTICES.md","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2FTHIRD_PARTY_NOTICES.md?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,22 @@\n+# Generated artifact asset notices\n+\n+The package LICENSE covers MJ-AgentLab's original template and runtime contributions,\n+including the scaffold portions of index.html, theme.css and learning.js. These\n+notices do not relicense supplied materials, learning content or source documents;\n+those retain their respective rights and permissions.\n+\n+The complete package notices below retain their original bytes. Paths such as\n+skills/site/references/resource-provenance.json refer to the original installed plugin,\n+not to files promised inside this generated artifact. The accompanying Apache text\n+preserves the package's upstream-reference notice and does not classify independently\n+implemented ideas or supplied content as Apache-licensed derivative works.\n+\n+---\n+\n+# Source and license notices\n+\n+The site extension contains original summaries and independently implemented tools. The method and file identities are recorded in `skills/site/references/resource-provenance.json`. Research checkouts have no identified redistribution license; no research source code or prose is copied verbatim into this distribution.\n+\n+General style-injection, copy-feedback and browser-geometry ideas were reviewed against evalstate/birch-html at e2ea9a3aca7e97f2b2a431cfa392aa4e99d8fa90. The visual direction also references ThariqS/html-effectiveness at 1787245d94aa680edf18b52027e3f859032776ba. Both fixed repositories identify Apache License 2.0 and Copyright 2026 Anthropic PBC. Their license text is retained in `licenses/Apache-2.0.txt`; upstream rights are not relabeled MIT. No Birch/HTML Plan runtime, remote font, script, stylesheet or automatic downloader is included.\n+\n+The package MIT license applies to its original contributions. Source and verification hashes establish byte identity, not authorship, semantic correctness or learning effects. AICS summaries remain Lab Proposal / Informative and do not announce a formal standard or adopted research rule."},{"sha":"db954bab41b1e3dc135733b5e2a210ab25d2f2eb","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/recovery-check/site-regenerated/artifact-manifest.json","status":"added","additions":53,"deletions":0,"changes":53,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Fartifact-manifest.json","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Fartifact-manifest.json","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Fartifact-manifest.json?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,53 @@\n+{\n+  \"schemaVersion\": 1,\n+  \"artifactPath\": \"artifact.json\",\n+  \"sourceSha256\": \"c80fdc5fbd113257d43779f67a783017b65a69f8318bb1405800f3c03352e44f\",\n+  \"version\": \"synthetic-1.0\",\n+  \"files\": [\n+    {\n+      \"path\": \"artifact.json\",\n+      \"sha256\": \"c80fdc5fbd113257d43779f67a783017b65a69f8318bb1405800f3c03352e44f\",\n+      \"bytes\": 4077\n+    },\n+    {\n+      \"path\": \"content.md\",\n+      \"sha256\": \"060045ce718168c7f3c2aecd2742518490d5693e3dbdeb28b4ac94ce2885cd50\",\n+      \"bytes\": 2751\n+    },\n+    {\n+      \"path\": \"index.html\",\n+      \"sha256\": \"12101458fb0d6d58bf902b8497feb73b742d3cec4e3409255fd07c7984de3785\",\n+      \"bytes\": 13298\n+    },\n+    {\n+      \"path\": \"learning.js\",\n+      \"sha256\": \"1fcc8c6064dd99f00b91103cf76e33d7a4e6dcf50793b4542bd8462f6c91f568\",\n+      \"bytes\": 7378\n+    },\n+    {\n+      \"path\": \"LICENSE\",\n+      \"sha256\": \"cfd483b2cc03452033bbc34d6ceabcc46d9917539070f6721d671705926a2a8d\",\n+      \"bytes\": 1068\n+    },\n+    {\n+      \"path\": \"licenses/Apache-2.0.txt\",\n+      \"sha256\": \"30deeaa611125310673e7c14b4892fb102fb56697ecfab3b49b77ca0190de7e1\",\n+      \"bytes\": 11343\n+    },\n+    {\n+      \"path\": \"sources/renewal-rules.md\",\n+      \"sha256\": \"2a95c4d9b95f3b184fea30aa3fba9daaf34d11624bd888ed4793a0ea7f96af47\",\n+      \"bytes\": 1011\n+    },\n+    {\n+      \"path\": \"theme.css\",\n+      \"sha256\": \"32c88191ef5e0c5e97668f22c6571d3f27d10ae76458ebdc31db6240b309f835\",\n+      \"bytes\": 6313\n+    },\n+    {\n+      \"path\": \"THIRD_PARTY_NOTICES.md\",\n+      \"sha256\": \"85d44b9273c04eda33d5f739f01cf4994fb8aeedb186955f5d7cd3336dd5e65e\",\n+      \"bytes\": 1944\n+    }\n+  ]\n+}"},{"sha":"d6d0f889354411fdc2342e376c4a5bd4adf88e26","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/recovery-check/site-regenerated/artifact.json","status":"added","additions":105,"deletions":0,"changes":105,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Fartifact.json","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Fartifact.json","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Fartifact.json?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,105 @@\n+{\n+  \"schemaVersion\": 1,\n+  \"title\": \"Library Renewal · 续借判断学习制品\",\n+  \"version\": \"synthetic-1.0\",\n+  \"audience\": \"能够读懂基本日期，但尚未区分规则许可、申请提交与完成确认的学习者。\",\n+  \"task\": \"根据本页自编规则，解释续借是否允许、成功或失败后的日期，以及确认完成所需依据。\",\n+  \"goals\": [\n+    \"用两个必要条件的组合解释规则许可，不把且改为或。\",\n+    \"从原到期日计算成功后的七个日历日，失败时保留原日期。\",\n+    \"区分提交、成功确认与未知结果，并指出确认所需的两项依据。\"\n+  ],\n+  \"markdown\": \"content.md\",\n+  \"sources\": [\n+    {\n+      \"id\": \"renewal-rules\",\n+      \"title\": \"Synthetic Renewal Rules · 自编续借规则\",\n+      \"path\": \"sources/renewal-rules.md\",\n+      \"locator\": \"LIB1–LIB4；本插件的合成验收材料，不是任何真实图书馆政策。\"\n+    }\n+  ],\n+  \"terms\": [\n+    {\n+      \"english\": \"Rule Permission\",\n+      \"chinese\": \"规则许可\",\n+      \"forbidden\": [\n+        \"规则批准\"\n+      ]\n+    },\n+    {\n+      \"english\": \"Submission\",\n+      \"chinese\": \"申请提交\"\n+    },\n+    {\n+      \"english\": \"Completion Confirmation\",\n+      \"chinese\": \"完成确认\"\n+    },\n+    {\n+      \"english\": \"Calendar Day\",\n+      \"chinese\": \"日历日\",\n+      \"forbidden\": [\n+        \"工作天\"\n+      ]\n+    }\n+  ],\n+  \"activities\": [\n+    {\n+      \"id\": \"permission-check\",\n+      \"type\": \"choice\",\n+      \"title\": \"Rule Permission · 核对规则许可\",\n+      \"prompt\": \"一本书尚未逾期，但已有其他读者预约。按 LIB2，本次是否允许续借？\",\n+      \"options\": [\n+        {\n+          \"label\": \"允许，因为尚未逾期。\",\n+          \"feedback\": \"尚未逾期只满足一项条件；LIB2 还要求没有其他读者预约。\"\n+        },\n+        {\n+          \"label\": \"不允许，因为预约条件不满足。\",\n+          \"feedback\": \"两个条件必须同时成立；已有预约使本次不满足完整规则。\"\n+        }\n+      ],\n+      \"correctIndex\": 1,\n+      \"reference\": \"本次不允许。LIB2 要求尚未逾期且没有其他读者预约，两项条件同时成立才规则允许；规则允许仍不等于已成功。\",\n+      \"sourceId\": \"renewal-rules\"\n+    },\n+    {\n+      \"id\": \"date-check\",\n+      \"type\": \"choice\",\n+      \"title\": \"Calendar Day · 核对跨月日期\",\n+      \"prompt\": \"原到期日为 2026-10-29。按 LIB3，续借成功与失败后分别何时归还？\",\n+      \"options\": [\n+        {\n+          \"label\": \"成功后为 2026-11-05；失败时仍为 2026-10-29。\",\n+          \"feedback\": \"成功从原到期日增加七个日历日，跨月仍适用；失败不改原日期。\"\n+        },\n+        {\n+          \"label\": \"成功和失败后都为 2026-11-05。\",\n+          \"feedback\": \"失败时没有日期延后；不能把成功后的效果套到失败状态。\"\n+        }\n+      ],\n+      \"correctIndex\": 0,\n+      \"reference\": \"成功：2026-11-05；失败：2026-10-29。日期基准是原到期日，不是申请日；增加的是七个日历日。\",\n+      \"sourceId\": \"renewal-rules\"\n+    },\n+    {\n+      \"id\": \"completion-check\",\n+      \"type\": \"choice\",\n+      \"title\": \"Completion Confirmation · 核对完成依据\",\n+      \"prompt\": \"已经点击申请，但尚未看到成功文字与更新后的归还日期。按 LIB4，此时能确认什么？\",\n+      \"options\": [\n+        {\n+          \"label\": \"已完成，因为已点击申请。\",\n+          \"feedback\": \"点击只表示申请提交，不能替代成功文字与日期更新两项确认依据。\"\n+        },\n+        {\n+          \"label\": \"已提交，结果尚不能确认；也不能据此断定失败。\",\n+          \"feedback\": \"LIB4 把提交与确认成功分开；缺少成功确认不等于已知失败。\"\n+        }\n+      ],\n+      \"correctIndex\": 1,\n+      \"reference\": \"只能确认申请提交。完成确认需同时有续借成功文字和更新后的归还日期；结果未确认时保留未知，不补造失败或后台步骤。\",\n+      \"sourceId\": \"renewal-rules\"\n+    }\n+  ],\n+  \"theme\": \"neutral\"\n+}"},{"sha":"4abaf6a89085af9ff0dc3765cdb079255595985e","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/recovery-check/site-regenerated/content.md","status":"added","additions":45,"deletions":0,"changes":45,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Fcontent.md","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Fcontent.md","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Fcontent.md?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,45 @@\n+# Overview · 先区分三个判断\n+\n+本材料使用项目自编的图书续借规则，帮助核对条件、日期与完成依据。它不是任何真实图书馆政策，不连接图书馆或提交真实申请。\n+\n+**Rule Permission**（规则许可）说明规则是否允许本次续借。**Submission**（申请提交）说明已提出申请。**Completion Confirmation**（完成确认）说明哪些可见依据足以确认成功；三个判断不能互相代替。\n+\n+## Necessary Foundations · 条件与日历日\n+\n+本练习只处理一本书的一次续借。两项条件用“且”连接，表示必须同时成立，不能满足一项就视为全部满足。**Calendar Day**（日历日）按连续日期计算，周末和跨月也计入。\n+\n+完整原件在 [Synthetic Renewal Rules](sources/renewal-rules.md)，以下解释对应 LIB2–LIB4。\n+\n+## Rule Permission · 同时核对两项条件\n+\n+尚未逾期且没有其他读者预约时，本练习规则允许续借。任一条件不满足，就不能按这条规则续借。规则允许不表示申请已经成功。\n+\n+| 尚未逾期 | 没有其他读者预约 | LIB2 的规则许可 |\n+| --- | --- | --- |\n+| 是 | 是 | 允许，但成功仍须按 LIB4 确认 |\n+| 是 | 否 | 不允许 |\n+| 否 | 是 | 不允许 |\n+| 否 | 否 | 不允许 |\n+\n+比较时同时查看四种组合。表格呈现条件组合，不表示先后办理步骤。\n+\n+## Date Outcome · 从原到期日计算\n+\n+按 LIB3，续借成功后，归还日期在原到期日基础上延后七个日历日；续借失败时，原到期日不变。\n+\n+- 原到期日 2026-10-20：成功后为 2026-10-27；失败时仍为 2026-10-20。\n+- 原到期日 2026-10-29：成功后为 2026-11-05；失败时仍为 2026-10-29。\n+\n+规则没有用申请日计算，也没有排除周末。日期结果需要已知成功或失败；结果未知时，不能自行选择其中一种结果来改写到期日。\n+\n+## Completion Confirmation · 保留未知结果\n+\n+按 LIB4，点击“申请续借”只表示申请提交。页面显示“续借成功”并更新归还日期后，才能确认续借完成，两项依据必须同时出现。\n+\n+没有成功确认不等于已确认失败。规则未提供完整后台状态机，也没有说明等待时长；不要自行补造审批步骤或超时失败。\n+\n+## Integrated Practice · 说明你的判断\n+\n+阅读下面的局部练习时，可以回查正文与来源。先写清当前给定条件，再解释规则、日期和完成状态分别能确认什么。修改答案后重新核对，不能沿用旧反馈。\n+\n+核对与反馈只对应这些教学题。页面可操作或一次答对，不能证明长期掌握、迁移能力或设计改善了理解；Understanding Effects 保持 NOT_MEASURED。"},{"sha":"adc8b0ea0a147de6422a660c4c91089981698f73","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/recovery-check/site-regenerated/index.html","status":"added","additions":36,"deletions":0,"changes":36,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Findex.html","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Findex.html","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Findex.html?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,36 @@\n+<!doctype html>\n+<html lang=\"zh-CN\">\n+<head>\n+  <meta charset=\"utf-8\">\n+  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n+  <meta name=\"description\" content=\"围绕明确读者、任务与材料制作的学习制品。\">\n+  <title>Library Renewal · 续借判断学习制品</title>\n+  <link rel=\"stylesheet\" href=\"theme.css\">\n+  <script src=\"learning.js\" defer></script>\n+</head>\n+<body>\n+  <a class=\"skip-link\" href=\"#main\">跳到正文</a>\n+  <div class=\"paper\"><header class=\"masthead\"><p>Learning Artifact · 学习制品</p><p>Version · synthetic-1.0</p></header><main id=\"main\"><section class=\"hero\"><p class=\"eyebrow\">Read · Explore · Check</p><h1>Library Renewal · 续借判断学习制品</h1><dl><dt>Audience · 目标读者</dt><dd>能够读懂基本日期，但尚未区分规则许可、申请提交与完成确认的学习者。</dd><dt>Task · 使用任务</dt><dd>根据本页自编规则，解释续借是否允许、成功或失败后的日期，以及确认完成所需依据。</dd></dl><h2>Understanding Goals · 理解目标</h2><ul><li>用两个必要条件的组合解释规则许可，不把且改为或。</li><li>从原到期日计算成功后的七个日历日，失败时保留原日期。</li><li>区分提交、成功确认与未知结果，并指出确认所需的两项依据。</li></ul><p class=\"scope\">Understanding Effects · NOT_MEASURED。页面、工程检查和本题核对各按实际范围报告，理解效果尚未测量。</p><a href=\"content.md\" download>下载材料 Markdown</a></section><section class=\"reading\" aria-label=\"学习材料\"><h2 id=\"section-1\">Overview · 先区分三个判断</h2>\n+<p>本材料使用项目自编的图书续借规则，帮助核对条件、日期与完成依据。它不是任何真实图书馆政策，不连接图书馆或提交真实申请。</p>\n+<p><strong>Rule Permission</strong>（规则许可）说明规则是否允许本次续借。<strong>Submission</strong>（申请提交）说明已提出申请。<strong>Completion Confirmation</strong>（完成确认）说明哪些可见依据足以确认成功；三个判断不能互相代替。</p>\n+<h3 id=\"section-2\">Necessary Foundations · 条件与日历日</h3>\n+<p>本练习只处理一本书的一次续借。两项条件用“且”连接，表示必须同时成立，不能满足一项就视为全部满足。<strong>Calendar Day</strong>（日历日）按连续日期计算，周末和跨月也计入。</p>\n+<p>完整原件在 <a href=\"sources/renewal-rules.md\">Synthetic Renewal Rules</a>，以下解释对应 LIB2–LIB4。</p>\n+<h3 id=\"section-3\">Rule Permission · 同时核对两项条件</h3>\n+<p>尚未逾期且没有其他读者预约时，本练习规则允许续借。任一条件不满足，就不能按这条规则续借。规则允许不表示申请已经成功。</p>\n+<div class=\"table-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"可横向查看的材料表格\"><table><thead><tr><th scope=\"col\">尚未逾期</th><th scope=\"col\">没有其他读者预约</th><th scope=\"col\">LIB2 的规则许可</th></tr></thead><tbody><tr><td>是</td><td>是</td><td>允许，但成功仍须按 LIB4 确认</td></tr><tr><td>是</td><td>否</td><td>不允许</td></tr><tr><td>否</td><td>是</td><td>不允许</td></tr><tr><td>否</td><td>否</td><td>不允许</td></tr></tbody></table></div>\n+<p>比较时同时查看四种组合。表格呈现条件组合，不表示先后办理步骤。</p>\n+<h3 id=\"section-4\">Date Outcome · 从原到期日计算</h3>\n+<p>按 LIB3，续借成功后，归还日期在原到期日基础上延后七个日历日；续借失败时，原到期日不变。</p>\n+<ul><li>原到期日 2026-10-20：成功后为 2026-10-27；失败时仍为 2026-10-20。</li><li>原到期日 2026-10-29：成功后为 2026-11-05；失败时仍为 2026-10-29。</li></ul>\n+<p>规则没有用申请日计算，也没有排除周末。日期结果需要已知成功或失败；结果未知时，不能自行选择其中一种结果来改写到期日。</p>\n+<h3 id=\"section-5\">Completion Confirmation · 保留未知结果</h3>\n+<p>按 LIB4，点击“申请续借”只表示申请提交。页面显示“续借成功”并更新归还日期后，才能确认续借完成，两项依据必须同时出现。</p>\n+<p>没有成功确认不等于已确认失败。规则未提供完整后台状态机，也没有说明等待时长；不要自行补造审批步骤或超时失败。</p>\n+<h3 id=\"section-6\">Integrated Practice · 说明你的判断</h3>\n+<p>阅读下面的局部练习时，可以回查正文与来源。先写清当前给定条件，再解释规则、日期和完成状态分别能确认什么。修改答案后重新核对，不能沿用旧反馈。</p>\n+<p>核对与反馈只对应这些教学题。页面可操作或一次答对，不能证明长期掌握、迁移能力或设计改善了理解；Understanding Effects 保持 NOT_MEASURED。</p>\n+</section><section aria-labelledby=\"terms-heading\"><h2 id=\"terms-heading\">Terminology · 术语</h2><dl class=\"terms\"><div><dt>Rule Permission</dt><dd>规则许可</dd></div><div><dt>Submission</dt><dd>申请提交</dd></div><div><dt>Completion Confirmation</dt><dd>完成确认</dd></div><div><dt>Calendar Day</dt><dd>日历日</dd></div></dl></section><section aria-labelledby=\"activities-heading\"><h2 id=\"activities-heading\">Local Practice · 局部练习</h2><p>先作判断，再核对参考与依据。参考仅适用于本题材料；作答不代表长期掌握或理解改善。</p><div class=\"practice-controls enhancement\"><p id=\"practice-status\" role=\"status\">尚未核对题目。</p><button type=\"button\" data-reset>重新开始</button></div><article class=\"activity\" id=\"activity-permission-check\"><h3>Rule Permission · 核对规则许可</h3><p class=\"scenario\">一本书尚未逾期，但已有其他读者预约。按 LIB2，本次是否允许续借？</p><form data-activity=\"permission-check\"><fieldset><legend>选择一个判断，再核对理由</legend><label class=\"option\"><input type=\"radio\" name=\"permission-check\" value=\"0\"><span>允许，因为尚未逾期。</span></label><label class=\"option\"><input type=\"radio\" name=\"permission-check\" value=\"1\"><span>不允许，因为预约条件不满足。</span></label></fieldset><button class=\"enhancement\" type=\"submit\">核对判断</button><div data-feedback id=\"feedback-permission-check\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></div></form><details><summary>Reference Judgment · 查看参考判断</summary><p>不允许，因为预约条件不满足。</p><p>本次不允许。LIB2 要求尚未逾期且没有其他读者预约，两项条件同时成立才规则允许；规则允许仍不等于已成功。</p><a href=\"#source-renewal-rules\">查看依据</a></details></article><article class=\"activity\" id=\"activity-date-check\"><h3>Calendar Day · 核对跨月日期</h3><p class=\"scenario\">原到期日为 2026-10-29。按 LIB3，续借成功与失败后分别何时归还？</p><form data-activity=\"date-check\"><fieldset><legend>选择一个判断，再核对理由</legend><label class=\"option\"><input type=\"radio\" name=\"date-check\" value=\"0\"><span>成功后为 2026-11-05；失败时仍为 2026-10-29。</span></label><label class=\"option\"><input type=\"radio\" name=\"date-check\" value=\"1\"><span>成功和失败后都为 2026-11-05。</span></label></fieldset><button class=\"enhancement\" type=\"submit\">核对判断</button><div data-feedback id=\"feedback-date-check\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></div></form><details><summary>Reference Judgment · 查看参考判断</summary><p>成功后为 2026-11-05；失败时仍为 2026-10-29。</p><p>成功：2026-11-05；失败：2026-10-29。日期基准是原到期日，不是申请日；增加的是七个日历日。</p><a href=\"#source-renewal-rules\">查看依据</a></details></article><article class=\"activity\" id=\"activity-completion-check\"><h3>Completion Confirmation · 核对完成依据</h3><p class=\"scenario\">已经点击申请，但尚未看到成功文字与更新后的归还日期。按 LIB4，此时能确认什么？</p><form data-activity=\"completion-check\"><fieldset><legend>选择一个判断，再核对理由</legend><label class=\"option\"><input type=\"radio\" name=\"completion-check\" value=\"0\"><span>已完成，因为已点击申请。</span></label><label class=\"option\"><input type=\"radio\" name=\"completion-check\" value=\"1\"><span>已提交，结果尚不能确认；也不能据此断定失败。</span></label></fieldset><button class=\"enhancement\" type=\"submit\">核对判断</button><div data-feedback id=\"feedback-completion-check\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></div></form><details><summary>Reference Judgment · 查看参考判断</summary><p>已提交，结果尚不能确认；也不能据此断定失败。</p><p>只能确认申请提交。完成确认需同时有续借成功文字和更新后的归还日期；结果未确认时保留未知，不补造失败或后台步骤。</p><a href=\"#source-renewal-rules\">查看依据</a></details></article></section><section aria-labelledby=\"reflection-heading\"><h2 id=\"reflection-heading\">Reflection · 应用与意见</h2><label for=\"reflection\">写下你的解释、应用判断或待核对问题</label><textarea id=\"reflection\" rows=\"5\"></textarea><p>记录只在当前页面会话中；刷新或关闭后不保留。可复制文字自行保存。</p><div class=\"enhancement export-controls\"><button type=\"button\" data-export>生成记录</button><button type=\"button\" data-copy disabled>复制记录</button><a data-download hidden download=\"learning-record.md\">下载记录</a></div><div class=\"enhancement export-box\"><label for=\"export-text\">本次记录，可手动复制</label><textarea id=\"export-text\" rows=\"8\" readonly aria-describedby=\"export-status\"></textarea><p id=\"export-status\" role=\"status\" aria-live=\"polite\"></p><button type=\"button\" data-copy-return hidden>返回复制按钮</button></div></section><section aria-labelledby=\"sources-heading\"><h2 id=\"sources-heading\">Sources and Scope · 来源与范围</h2><ol class=\"sources\"><li id=\"source-renewal-rules\"><strong>Synthetic Renewal Rules · 自编续借规则</strong><p>LIB1–LIB4；本插件的合成验收材料，不是任何真实图书馆政策。</p><a href=\"sources/renewal-rules.md\">读取本地材料</a></li></ol></section></main><footer>材料、练习记录、实际检查与学习效果分别判断。</footer></div>\n+  <script type=\"application/json\" id=\"artifact-state\">{\"title\":\"Library Renewal · 续借判断学习制品\",\"version\":\"synthetic-1.0\",\"audience\":\"能够读懂基本日期，但尚未区分规则许可、申请提交与完成确认的学习者。\",\"task\":\"根据本页自编规则，解释续借是否允许、成功或失败后的日期，以及确认完成所需依据。\",\"activities\":[{\"id\":\"permission-check\",\"type\":\"choice\",\"title\":\"Rule Permission · 核对规则许可\",\"prompt\":\"一本书尚未逾期，但已有其他读者预约。按 LIB2，本次是否允许续借？\",\"options\":[{\"label\":\"允许，因为尚未逾期。\",\"feedback\":\"尚未逾期只满足一项条件；LIB2 还要求没有其他读者预约。\"},{\"label\":\"不允许，因为预约条件不满足。\",\"feedback\":\"两个条件必须同时成立；已有预约使本次不满足完整规则。\"}],\"correctIndex\":1,\"reference\":\"本次不允许。LIB2 要求尚未逾期且没有其他读者预约，两项条件同时成立才规则允许；规则允许仍不等于已成功。\",\"sourceId\":\"renewal-rules\"},{\"id\":\"date-check\",\"type\":\"choice\",\"title\":\"Calendar Day · 核对跨月日期\",\"prompt\":\"原到期日为 2026-10-29。按 LIB3，续借成功与失败后分别何时归还？\",\"options\":[{\"label\":\"成功后为 2026-11-05；失败时仍为 2026-10-29。\",\"feedback\":\"成功从原到期日增加七个日历日，跨月仍适用；失败不改原日期。\"},{\"label\":\"成功和失败后都为 2026-11-05。\",\"feedback\":\"失败时没有日期延后；不能把成功后的效果套到失败状态。\"}],\"correctIndex\":0,\"reference\":\"成功：2026-11-05；失败：2026-10-29。日期基准是原到期日，不是申请日；增加的是七个日历日。\",\"sourceId\":\"renewal-rules\"},{\"id\":\"completion-check\",\"type\":\"choice\",\"title\":\"Completion Confirmation · 核对完成依据\",\"prompt\":\"已经点击申请，但尚未看到成功文字与更新后的归还日期。按 LIB4，此时能确认什么？\",\"options\":[{\"label\":\"已完成，因为已点击申请。\",\"feedback\":\"点击只表示申请提交，不能替代成功文字与日期更新两项确认依据。\"},{\"label\":\"已提交，结果尚不能确认；也不能据此断定失败。\",\"feedback\":\"LIB4 把提交与确认成功分开；缺少成功确认不等于已知失败。\"}],\"correctIndex\":1,\"reference\":\"只能确认申请提交。完成确认需同时有续借成功文字和更新后的归还日期；结果未确认时保留未知，不补造失败或后台步骤。\",\"sourceId\":\"renewal-rules\"}],\"sources\":[{\"id\":\"renewal-rules\",\"title\":\"Synthetic Renewal Rules · 自编续借规则\",\"path\":\"sources/renewal-rules.md\",\"locator\":\"LIB1–LIB4；本插件的合成验收材料，不是任何真实图书馆政策。\"}]}</script>\n+</body>\n+</html>"},{"sha":"cbd7908d6d6fe04089f2a1fef5aa993865bcb5e4","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/recovery-check/site-regenerated/learning.js","status":"added","additions":102,"deletions":0,"changes":102,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Flearning.js","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Flearning.js","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Flearning.js?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,102 @@\n+/* Original, optional browser-local practice. No network, stored account or persisted grade. */\n+(() => {\n+  \"use strict\";\n+  let config;\n+  try { config = JSON.parse(document.getElementById(\"artifact-state\").textContent); }\n+  catch { return; }\n+  if (!Array.isArray(config.activities)) return;\n+  document.documentElement.classList.add(\"js\");\n+  const byID = id => document.getElementById(id);\n+  const exportField = byID(\"export-text\"), exportStatus = byID(\"export-status\"), summary = byID(\"practice-status\");\n+  const copy = document.querySelector(\"[data-copy]\"), download = document.querySelector(\"[data-download]\"), copyReturn = document.querySelector(\"[data-copy-return]\");\n+  let revision = 0, downloadURL = null;\n+  const paragraph = (target, value) => { const p = document.createElement(\"p\"); p.textContent = value; target.append(p); };\n+  const invalidate = () => {\n+    revision++;\n+    if (exportField.value) { exportField.value = \"\"; exportStatus.textContent = \"回答或核对记录已改变，请重新生成记录。\"; }\n+    copy.disabled = true;\n+    copyReturn.hidden = true;\n+    download.hidden = true; download.removeAttribute(\"href\");\n+    if (downloadURL) { URL.revokeObjectURL(downloadURL); downloadURL = null; }\n+  };\n+  const questions = config.activities.map(activity => {\n+    const form = document.querySelector(`form[data-activity=\"${activity.id}\"]`);\n+    return { activity, form, radios: Array.from(form.querySelectorAll('input[type=\"radio\"]')), feedback: form.querySelector(\"[data-feedback]\"), attempts: 0, result: null };\n+  });\n+  const selected = question => question.radios.findIndex(radio => radio.checked);\n+  const updateSummary = () => { if (summary) summary.textContent = `当前已核对 ${questions.filter(question => question.result !== null).length} / ${questions.length} 题；修改后需重新核对。`; };\n+  questions.forEach(question => {\n+    const { form, radios, feedback, activity } = question;\n+    radios.forEach(radio => { radio.setAttribute(\"aria-describedby\", feedback.id); radio.addEventListener(\"change\", () => {\n+      question.result = null; feedback.replaceChildren(); delete feedback.dataset.result;\n+      paragraph(feedback, \"回答已修改，请重新核对。\"); invalidate(); updateSummary();\n+    }); });\n+    form.addEventListener(\"submit\", event => {\n+      event.preventDefault(); feedback.replaceChildren();\n+      const index = selected(question);\n+      if (index < 0) { delete feedback.dataset.result; paragraph(feedback, \"请先选择一个判断。未选择不算回答。\"); radios[0].focus(); return; }\n+      question.attempts++;\n+      question.result = { index, matched: index === activity.correctIndex };\n+      invalidate();\n+      feedback.dataset.result = question.result.matched ? \"match\" : \"review\";\n+      paragraph(feedback, `你的选择：${activity.options[index].label}`);\n+      paragraph(feedback, question.result.matched ? \"与本题参考判断匹配。\" : \"这一判断需要复核，可以修改后重试。\");\n+      paragraph(feedback, activity.options[index].feedback);\n+      paragraph(feedback, `参考判断：${activity.reference}`);\n+      const source = document.createElement(\"a\"); source.href = `#source-${activity.sourceId}`; source.textContent = \"查看依据\"; feedback.append(source);\n+      paragraph(feedback, `本题核对 ${question.attempts} 次；记录只对应本题。`);\n+      updateSummary();\n+    });\n+  });\n+  document.querySelector(\"[data-reset]\")?.addEventListener(\"click\", () => {\n+    questions.forEach(question => { question.form.reset(); question.radios.forEach(radio => { radio.checked = false; }); question.result = null; question.attempts = 0; question.feedback.replaceChildren(); delete question.feedback.dataset.result; });\n+    byID(\"reflection\").value = \"\"; invalidate(); updateSummary();\n+    exportStatus.textContent = \"本次练习已重置。记录只在当前页面会话中。\";\n+  });\n+  byID(\"reflection\").addEventListener(\"input\", invalidate);\n+  document.querySelector(\"[data-export]\").addEventListener(\"click\", () => {\n+    invalidate();\n+    const lines = [`# ${config.title} — 本次学习记录`, \"\", `- 材料版本：${config.version}`, `- 记录时间：${new Date().toISOString()}`, `- Audience：${config.audience}`, `- Task：${config.task}`, \"- 范围：当前会话的回答与核对；理解效果 NOT_MEASURED。\", \"\"];\n+    questions.forEach(question => {\n+      const { activity, result } = question, index = selected(question);\n+      lines.push(`## ${activity.id} · ${activity.title}`, \"\", `- 题目：${activity.prompt}`, `- 当前选择：${index < 0 ? \"未选择\" : activity.options[index].label}`, `- 核对次数：${question.attempts}`, `- 本次判断：${result ? result.matched ? \"与参考匹配\" : \"需要复核\" : \"当前选择尚未核对\"}`);\n+      if (result) lines.push(`- 对应反馈：${activity.options[result.index].feedback}`);\n+      lines.push(`- 参考判断：${activity.reference}`, `- 来源 ID：${activity.sourceId}`, `- 页面回查：#source-${activity.sourceId}`, \"\");\n+    });\n+    lines.push(\"## Sources · 来源\", \"\");\n+    for (const source of config.sources || []) {\n+      lines.push(`### ${source.id} · ${source.title}`, \"\", `- 来源 ID：${source.id}`, `- 标题：${source.title}`, `- 定位：${source.locator}`);\n+      if (source.path) lines.push(`- 制品内相对路径：${source.path}`);\n+      if (source.url) lines.push(`- 来源 URL：${source.url}`);\n+      lines.push(\"\");\n+    }\n+    lines.push(\"## 应用与意见\", \"\", byID(\"reflection\").value.trim() || \"尚未填写。\", \"\", \"记录未上传、未持久化；保存导出后由你自行保留。\", \"\");\n+    exportField.value = lines.join(\"\\n\"); copy.disabled = false;\n+    if (typeof Blob !== \"undefined\" && typeof URL.createObjectURL === \"function\") { downloadURL = URL.createObjectURL(new Blob([exportField.value], { type: \"text/markdown;charset=utf-8\" })); download.href = downloadURL; download.hidden = false; }\n+    exportStatus.textContent = \"已生成记录，可复制、下载或在文本区手动复制。\";\n+  });\n+  copy.addEventListener(\"click\", async () => {\n+    if (!exportField.value) { exportStatus.textContent = \"请先生成记录。\"; return; }\n+    const started = revision, value = exportField.value;\n+    try {\n+      if (!navigator.clipboard?.writeText) throw new Error(\"clipboard unavailable\");\n+      await navigator.clipboard.writeText(value);\n+      if (started === revision) { copyReturn.hidden = true; exportStatus.textContent = \"已复制本次记录。\"; }\n+    } catch {\n+      if (started !== revision) return;\n+      copyReturn.hidden = false;\n+      exportStatus.textContent = \"自动复制未成功。已选中导出文字，请手动复制；完成或取消后可按 Escape，或用返回复制按钮离开。\";\n+      exportField.focus(); exportField.select();\n+    }\n+  });\n+  const leaveManualCopy = () => {\n+    if (copyReturn.hidden) return;\n+    copyReturn.hidden = true;\n+    exportStatus.textContent = \"已返回复制按钮；手动复制是否完成未作确认。\";\n+    copy.focus();\n+  };\n+  copyReturn.addEventListener(\"click\", leaveManualCopy);\n+  exportField.addEventListener(\"keydown\", event => { if (event.key === \"Escape\" && !copyReturn.hidden) { event.preventDefault(); leaveManualCopy(); } });\n+  window.addEventListener(\"pagehide\", () => { if (downloadURL) URL.revokeObjectURL(downloadURL); });\n+  updateSummary();\n+})();"},{"sha":"02fe842ca3981cb570fe033ebd5a9b1252ba6339","filename":"plans/274-html-learning-artifact/evidence/sources/align274/local/run-independent-r1/recovery-check/site-regenerated/licenses/Apache-2.0.txt","status":"added","additions":201,"deletions":0,"changes":201,"blob_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/blob/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Flicenses%2FApache-2.0.txt","raw_url":"https://github.com/MJ-AgentLab/mj-agentlab-marketplace/raw/7c23f347c0725bdfa57ee1e0f5e9075a8d90babf/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Flicenses%2FApache-2.0.txt","contents_url":"https://api.github.com/repos/MJ-AgentLab/mj-agentlab-marketplace/contents/plans%2F274-html-learning-artifact%2Fevidence%2Fsources%2Falign274%2Flocal%2Frun-independent-r1%2Frecovery-check%2Fsite-regenerated%2Flicenses%2FApache-2.0.txt?ref=7c23f347c0725bdfa57ee1e0f5e9075a8d90babf","patch":"@@ -0,0 +1,201 @@\n+                                 Apache License\n+                           Version 2.0, January 2004\n+                        http://www.apache.org/licenses/\n+\n+   TERMS AND CONDITIONS FOR USE, REPRODUCTION, AND DISTRIBUTION\n+\n+   1. Definitions.\n+\n+      \"License\" shall mean the terms and conditions for use, reproduction,\n+      and distribution as defined by Sections 1 through 9 of this document.\n+\n+      \"Licensor\" shall mean the copyright owner or entity authorized by\n+      the copyright owner that is granting the License.\n+\n+      \"Legal Entity\" shall mean the union of the acting entity and all\n+      other entities that control, are controlled by, or are under common\n+      control with that entity. For the purposes of this definition,\n+      \"control\" means (i) the power, direct or indirect, to cause the\n+      direction or management of such entity, whether by contract or\n+      otherwise, or (ii) ownership of fifty percent (50%) or more of the\n+      outstanding shares, or (iii) beneficial ownership of such entity.\n+\n+      \"You\" (or \"Your\") shall mean an individual or Legal Entity\n+      exercising permissions granted by this License.\n+\n+      \"Source\" form shall mean the preferred form for making modifications,\n+      including but not limited to software source code, documentation\n+      source, and configuration files.\n+\n+      \"Object\" form shall mean any form resulting from mechanical\n+      transformation or translation of a Source form, including but\n+      not limited to compiled object code, generated documentation,\n+      and conversions to other media types.\n+\n+      \"Work\" shall mean the work of authorship, whether in Source or\n+      Object form, made available under the License, as indicated by a\n+      copyright notice that is included in or attached to the work\n+      (an example is provided